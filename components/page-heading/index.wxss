:host { display: block; }
.header { margin: 8rpx 0 28rpx; }
.eyebrow { color: var(--yc-primary); font-size: 28rpx; line-height: 1.6; }
.title { color: var(--yc-text); font-size: 44rpx; font-weight: 600; line-height: 1.5; margin: 8rpx 0; }
.description { color: var(--yc-muted); font-size: 28rpx; line-height: 1.7; }
.scope { color: var(--yc-text); background: var(--yc-surface); border: 1rpx solid var(--yc-border); padding: 24rpx 28rpx; border-radius: 18rpx; margin: 24rpx 0; font-size: 30rpx; line-height: 1.6; overflow-wrap: anywhere; }
