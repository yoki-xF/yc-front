<view class="workspace">
  <view class="ws-header"><view class="ws-eyebrow">易彩 · 经营管理</view><view class="ws-title">老板工作台</view><view class="ws-subtitle">营业、经营记录与团队，按当前账号权限展示。</view></view>
  <view wx:if="{{loading}}" class="ws-card ws-note">正在读取权限…</view>
  <view wx:elif="{{error}}" class="ws-card"><view class="ws-error">{{error}}</view><button bindtap="retry">重试读取</button><button class="ws-primary" bindtap="login">登录账号</button></view>
  <block wx:else>
    <view class="ws-eyebrow">{{nickname}}</view>
    <view class="ws-section">营业管理</view>
    <view class="ws-card">
      <button class="ws-row" wx:if="{{operatingAccess}}" bindtap="operatingDay"><view class="ws-row-label"><text>门店开店与结店</text><text>›</text></view><view class="ws-tile-description">跨午夜仍归开店当天，核对后结店</view></button>
      <button class="ws-row" wx:if="{{openingAccess}}" bindtap="opening"><view class="ws-row-label"><text>新门店首次初始化</text><text>›</text></view><view class="ws-tile-description">首次库存与资金，保留历史保护</view></button>
      <button class="ws-row" wx:if="{{settingsAccess}}" bindtap="settings"><view class="ws-row-label"><text>经营设置</text><text>›</text></view></button>
      <view wx:if="{{!operatingAccess && !openingAccess && !settingsAccess}}" class="ws-note">当前账号没有营业管理权限。</view>
    </view>
    <button class="ws-primary" wx:if="{{reportAccess}}" type="primary" bindtap="reports">门店报表与销量排名</button>
    <view wx:if="{{availabilityNotice}}" class="ws-note">{{availabilityNotice}}</view>
    <view class="ws-section">经营记录与团队</view>
    <view wx:if="{{!modules.length}}" class="ws-card ws-note">当前账号未开通老板管理功能，请联系管理员。</view>
    <view class="ws-grid"><button class="ws-tile" wx:for="{{modules}}" wx:key="key" data-key="{{item.key}}" bindtap="open"><view class="ws-tile-title">{{item.title}}</view><view class="ws-tile-description">查看记录与可用操作 ›</view></button></view>
    <view class="ws-section">配置与账号</view><view class="ws-card"><button class="ws-row" wx:if="{{adminAccess}}" bindtap="admin"><view class="ws-row-label"><text>后台管理与门店配置</text><text>›</text></view></button><button class="ws-row" bindtap="profile"><view class="ws-row-label"><text>个人资料与密码</text><text>›</text></view></button></view>
  </block>
</view>
