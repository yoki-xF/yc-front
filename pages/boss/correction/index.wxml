<view class="page"><view wx:if="{{loading}}" class="card">正在读取更正数据…</view><block wx:else>
<view wx:if="{{blockedReason && !readOnly}}" class="card">{{blockedReason}}</view>
<block wx:if="{{canCorrect && !readOnly && !saved}}"><view class="card"><view class="heading">更正输入</view><view wx:for="{{fields}}" wx:for-item="field" wx:key="key" class="form-row"><view class="label">{{field.label}}</view><input value="{{values[field.key]}}" data-key="{{field.key}}" bindinput="input" disabled="{{busy || pending || conflict}}"/></view></view><view wx:for="{{lines}}" wx:key="id" class="card"><view class="heading">{{item.materialName}}</view><view class="row"><text>包数</text><input type="number" value="{{item.invPackageNum}}" data-index="{{index}}" data-key="invPackageNum" bindinput="quantity" disabled="{{busy || pending || conflict}}"/></view><view class="row"><text>张数</text><input type="number" value="{{item.invZhangNum}}" data-index="{{index}}" data-key="invZhangNum" bindinput="quantity" disabled="{{busy || pending || conflict}}"/></view></view><view class="card"><view class="label">更正原因（5至500字）</view><textarea value="{{reason}}" bindinput="reason" maxlength="500" disabled="{{busy || pending || conflict}}"/></view><button wx:if="{{!pending}}" bindtap="preview" disabled="{{busy || conflict}}">预览更正影响</button></block>
<view wx:if="{{preview}}" class="card"><view class="heading">盘点差异</view><view wx:for="{{preview.changes}}" wx:key="name" class="row"><text>{{item.name}}</text><text>{{item.before}} → {{item.after}}</text></view><view class="hint">{{preview.notice}}</view></view>
<view wx:if="{{impacts.length}}" class="card"><view class="heading">关联库存与余额</view><view wx:for="{{impacts}}" wx:key="name" class="row"><text>{{item.name}}</text><text>{{item.before}} → {{item.after}}</text></view></view>
<view wx:if="{{preview && reportRows.length}}" class="card"><view class="heading">日报重算预览</view><view wx:for="{{reportRows}}" wx:key="name" class="row"><text>{{item.name}}</text><text>{{item.before}} → {{item.after}}</text></view></view>
<view wx:if="{{error}}" class="card error">{{error}}</view><view wx:if="{{notice}}" class="card">{{notice}}</view>
<button wx:if="{{preview && !pending && !saved}}" type="primary" bindtap="submit" disabled="{{busy || conflict}}">确认更正</button><button wx:if="{{pending}}" type="primary" bindtap="sendPending" disabled="{{busy}}">使用原请求重试</button><button wx:if="{{conflict && !pending}}" bindtap="reload" disabled="{{busy}}">放弃草稿并读取最新记录</button>
<view class="card"><view class="heading">更正记录</view><view wx:if="{{!history.length}}" class="hint">暂无更正记录</view><view wx:for="{{history}}" wx:for-item="audit" wx:key="id" class="audit"><view>{{audit.reason}}</view><view class="hint">{{audit.createdAt}} · 操作人 {{audit.actorId}}</view><view wx:for="{{audit.changes}}" wx:key="name" class="row"><text>{{item.name}}</text><text>{{item.before}} → {{item.after}}</text></view></view></view>
<button bindtap="back" disabled="{{busy}}">返回详情</button></block></view>
