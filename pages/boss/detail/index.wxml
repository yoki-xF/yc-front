<view class="page"><view wx:if="{{deleteDone}}" class="card">操作成功。<button bindtap="back">返回列表</button></view><view wx:elif="{{loading}}" class="card">正在读取详情…</view><view wx:elif="{{error}}" class="card error">{{error}}<button bindtap="retry">{{deleteUncertain ? '返回列表核对' : '重新读取'}}</button></view><block wx:elif="{{record}}"><view class="card"><view class="heading">{{record.title}}</view><view wx:for="{{record.fields}}" wx:key="key" class="row"><text>{{item.label}}</text><text>{{item.value}}</text></view></view><view wx:for="{{record.lines}}" wx:key="index" class="card"><view class="heading">{{item.name}}</view><view class="row"><text>面值</text><text>{{item.money}}</text></view><view class="row"><text>单包价格</text><text>{{item.price}}</text></view><view class="row"><text>包数 / 张数</text><text>{{item.packages}} / {{item.sheets}}</text></view></view><button wx:if="{{record.canViewVouchers}}" bindtap="vouchers">查看营业凭证</button><button wx:if="{{record.canManageRole}}" bindtap="manageRole">配置功能权限与数据范围</button><button wx:if="{{record.canManageUser}}" bindtap="manageUser">账号启停、密码与角色</button><button wx:if="{{record.canDelete}}" bindtap="removeCatalog" loading="{{deleteBusy}}" disabled="{{deleteBusy || deleteUncertain}}">{{type === 'attendance' ? '取消未打卡排班' : type === 'materials' ? '删除未引用物料' : '删除成本记录'}}</button><button wx:if="{{record.canEdit}}" type="primary" bindtap="edit">编辑记录</button><view wx:if="{{record.correctionBlockedReason}}" class="card">{{record.correctionBlockedReason}}</view><button wx:if="{{record.canCorrect}}" type="primary" bindtap="correct">更正盘点记录</button><button wx:if="{{record.hasCorrectionHistory}}" bindtap="history">查看更正记录</button></block></view>
