<view class="page yc-page">
  <page-heading eyebrow="经营管理" title="门店经营报表" description="门店统一核算资金与盈亏，个人只统计销量。" /><view wx:if="{{loading}}" class="card">正在读取权限…</view><block wx:else><view wx:if="{{!ready}}" class="card"><view class="error">{{error}}</view><button type="primary" bindtap="retry">重新读取权限</button><button bindtap="login">前往登录</button></view><block wx:else>
<view class="card"><view class="segments"><button wx:for="{{['day','week','month','custom']}}" wx:key="*this" data-kind="{{item}}" bindtap="period" class="{{period === item ? 'selected' : ''}}" disabled="{{busy}}">{{item === 'day' ? '日' : item === 'week' ? '周' : item === 'month' ? '月' : '自定义'}}</button></view><picker range="{{depts}}" range-key="name" value="{{deptIndex}}" bindchange="pick" disabled="{{busy}}"><view class="choice">{{depts[deptIndex].name || '选择门店'}}</view></picker><view class="row"><picker mode="date" value="{{start}}" data-key="start" bindchange="date" disabled="{{busy}}">{{start}}</picker><text>至</text><picker mode="date" value="{{end}}" data-key="end" bindchange="date" disabled="{{busy}}">{{end}}</picker></view><view class="hint">按开店日期归属营业日，跨午夜不拆分。</view><button type="primary" bindtap="load" disabled="{{busy}}" loading="{{busy}}">查询</button></view>
<view wx:if="{{error}}" class="card error">{{error}}<button bindtap="retry">重试</button></view>
<block wx:if="{{report}}"><view class="card"><view class="heading">已核对营业日销量</view><view class="amount">{{report.summary.totalSales}} 元</view><view class="hint">{{report.range}}</view><view class="row"><text>即开</text><text>{{report.summary.instantSales}}</text></view><view class="row"><text>电彩</text><text>{{report.summary.electronicSales}}</text></view><view class="row"><text>竞彩</text><text>{{report.summary.sportsBettingSales}}</text></view><view class="row"><text>门店资金账差</text><text>{{report.summary.variance}}</text></view><view class="row"><text>错票（单列）</text><text>{{report.summary.wrongTicket}}</text></view><view class="hint">已核对 {{report.summary.freshDays}} 个营业日 · 待核对 {{report.summary.pendingDays}} 个 · 未营业 {{report.summary.notOpenDays}} 个</view><view wx:if="{{report.summary.pendingDays}}" class="warning">合计仅包含已核对营业日。存在未完成日报的门店不参与排名。</view></view>
<view class="segments"><button data-tab="report" bindtap="tab" class="{{tab === 'report' ? 'selected' : ''}}">门店汇总</button><button data-tab="rank" bindtap="tab" class="{{tab === 'rank' ? 'selected' : ''}}">销量排名</button></view>
<view wx:if="{{!hasRows}}" class="card">{{tab === 'rank' ? '暂无已完整核对且有营业记录的门店' : '所选范围内暂无门店数据'}}</view>
<view wx:for="{{rows}}" wx:key="deptId" class="card"><view class="heading"><text wx:if="{{tab === 'rank'}}">{{item.rank}} · </text>{{item.deptName}}</view><view class="row"><text>总销量</text><text>{{item.sales}}</text></view><view wx:if="{{!item.complete}}" class="hint">已核对部分销量 {{item.knownSales}} 元</view><view class="row"><text>即开 / 电彩 / 竞彩</text><text>{{item.instantSales}} / {{item.electronicSales}} / {{item.sportsBettingSales}}</text></view><view class="row"><text>资金账差</text><text>{{item.variance}}</text></view><view class="hint">已核对 {{item.freshDays}} 日 · 待核对 {{item.pendingDays}} 日</view><button data-id="{{item.deptId}}" bindtap="details">查看营业日明细</button></view>
<view wx:if="{{selectedStore}}" class="card"><view class="heading">{{selectedStore.name}} · 营业日明细</view><view wx:for="{{days}}" wx:key="businessDate" class="day"><view class="row"><text>{{item.businessDate}}</text><text>{{item.statusLabel}}</text></view><block wx:if="{{item.status === 'FRESH'}}"><view class="row"><text>即开 / 电彩 / 竞彩</text><text>{{item.instantSales}} / {{item.electronicSales}} / {{item.sportsBettingSales}}</text></view><view class="row"><text>销量 / 资金账差</text><text>{{item.totalSales}} / {{item.variance}}</text></view><view class="row"><text>错票</text><text>{{item.wrongTicket}}</text></view></block></view></view>
</block></block></block></view>
