.page{padding:28rpx;background:#f5f7fa;min-height:100vh;box-sizing:border-box;color:#1f2937;font-size:30rpx}.card{background:#fff;border-radius:16rpx;padding:28rpx;margin-bottom:24rpx}.heading{font-size:34rpx;font-weight:600;margin-bottom:20rpx}.hint{color:#667085;font-size:26rpx;margin:16rpx 0}.error{color:#b42318;overflow-wrap:anywhere}.row{display:flex;justify-content:space-between;gap:24rpx;padding:16rpx 0;border-bottom:1rpx solid #f0f2f5}.row>text:last-child{max-width:65%;text-align:right;overflow-wrap:anywhere}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.grid button{width:100%;margin:0;background:#fff;font-size:30rpx}.actions{display:flex;gap:20rpx;margin-top:20rpx}.actions button{flex:1;font-size:28rpx}.arrow{float:right;color:#667085}input{padding:20rpx;background:#f5f7fa;border-radius:10rpx}button{margin-top:16rpx}

.segments{display:flex;gap:12rpx;margin:20rpx 0}.segments button{flex:1;margin:0;font-size:28rpx;padding:0 12rpx;border:2rpx solid #d0d5dd;background:#fff}.segments .selected{background:#e8f1ff;border-color:#2463d4;color:#174ca6;font-weight:600}.choice{background:#f3f5f9;padding:20rpx;border-radius:12rpx}.amount{font-size:42rpx;font-weight:600}.warning{color:#8a4100;font-size:28rpx;margin-top:16rpx}.day{padding:20rpx 0;border-bottom:2rpx solid #e4e7ec}.page{padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}
