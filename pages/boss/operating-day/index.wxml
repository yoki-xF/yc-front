<view class="page">
  <view class="heading">门店开店与结店</view>
  <view class="card hint">新门店先完成首次资金与库存初始化。开店后，由员工完成早盘、营业记账与晚盘。跨午夜仍归开店当天；核对后结店，统一生成门店日报。</view>
  <view wx:if="{{loading}}" class="card">正在读取…</view>
  <block wx:else>
    <picker range="{{departments}}" range-key="name" value="{{deptIndex}}" disabled="{{busy || pending}}" bindchange="department"><view class="card">{{deptIndex >= 0 ? departments[deptIndex].name : '请选择门店'}} ›</view></picker>
    <view wx:if="{{error}}" class="card error">{{error}}</view>
    <view wx:if="{{notice}}" class="card">{{notice}}</view>
    <view wx:if="{{pending}}" class="card"><view>有一笔提交结果待确认，核对完成后才能继续操作。</view><button type="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="retry">重试原请求</button></view>
    <view wx:if="{{status}}" class="card">
      <view>营业日期：{{status.businessDate}}</view>
      <view>状态：{{status.status === 'OPEN' ? '营业中' : status.status === 'CLOSED' ? '已结店' : '未开店'}}</view>
      <button wx:if="{{status.status === 'NOT_OPEN' && canOpen && !pending}}" type="primary" disabled="{{busy}}" bindtap="open">确认开店</button>
      <button wx:if="{{status.status === 'OPEN' && canClose && !pending}}" disabled="{{busy}}" bindtap="preview">核对结店数据</button>
    </view>
    <view wx:if="{{preview}}" class="card">
      <view class="heading">结店核对 · {{preview.businessDate}}</view>
      <view class="fund" wx:for="{{preview.funds}}" wx:key="key"><view>{{item.label}}</view><view>早班 {{item.opening}} → 晚班 {{item.closing}}</view></view>
      <view>即开销量：{{preview.report.instantSales}} 元</view>
      <view>电彩销量：{{preview.report.electronicSales}} 元</view>
      <view>竞彩销量：{{preview.report.sportsBettingSales}} 元</view>
      <view>总销量：{{preview.report.totalSales}} 元</view>
      <view>兑奖、缴款等调整：{{preview.report.adjustments}} 元</view>
      <view>备付金转入：{{preview.report.reserveIn}} 元</view>
      <view>错票（单列）：{{preview.report.wrongTicket}} 元</view>
      <view class="heading">资金账差：{{preview.report.variance}} 元</view>
      <view class="hint">盈亏归门店统一核算，个人仅统计电彩和竞彩销量。提交期间如单据发生变化，须重新核对。</view>
      <button type="primary" disabled="{{busy || pending}}" loading="{{busy}}" bindtap="close">确认核对并结店</button>
    </view>
    <button wx:if="{{deptIndex >= 0}}" disabled="{{busy}}" bindtap="refresh">重新读取状态</button>
  </block>
</view>
