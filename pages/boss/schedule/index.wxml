<view class="page">
  <view wx:if="{{loading}}" class="card">正在读取排班…</view>
  <block wx:else>
    <view class="card">
      <view class="hint">支持安排今天至未来一年内的班次。历史排班及已有打卡记录请联系管理员核对。</view>
      <view class="form-row"><view class="label">门店</view><picker range="{{depts}}" range-key="name" value="{{deptIndex}}" data-key="deptIndex" bindchange="pick" disabled="{{editing || busy || saved || uncertain}}"><view class="choice">{{deptIndex >= 0 ? depts[deptIndex].name : '请选择门店'}}</view></picker></view>
      <view wx:if="{{optionsLoading}}" class="hint">正在读取门店员工与班次…</view>
      <view class="form-row"><view class="label">员工</view><picker range="{{users}}" range-key="name" value="{{userIndex}}" data-key="userIndex" bindchange="pick" disabled="{{optionsLoading || busy || saved || uncertain}}"><view class="choice">{{userIndex >= 0 ? users[userIndex].name : '请选择有效员工'}}</view></picker></view>
      <view class="form-row"><view class="label">班次</view><picker range="{{configs}}" range-key="name" value="{{configIndex}}" data-key="configIndex" bindchange="pick" disabled="{{optionsLoading || busy || saved || uncertain}}"><view class="choice">{{configIndex >= 0 ? configs[configIndex].name : '请选择门店班次'}}</view></picker></view>
      <view class="form-row"><view class="label">排班日期</view><picker mode="date" value="{{date}}" bindchange="date" disabled="{{busy || saved || uncertain}}"><view class="choice">{{date || '请选择日期'}}</view></picker></view>
      <view class="form-row"><view class="label">出勤状态</view><picker range="{{statuses}}" value="{{statusIndex}}" data-key="statusIndex" bindchange="pick" disabled="{{busy || saved || uncertain}}"><view class="choice">{{statuses[statusIndex]}}</view></picker></view>
    </view>
    <view wx:if="{{error}}" class="card error">{{error}}<button wx:if="{{!saved && !uncertain}}" bindtap="retry" disabled="{{busy}}">重新读取</button></view>
    <view wx:if="{{notice}}" class="card">{{notice}}</view>
    <button wx:if="{{!saved && !uncertain}}" type="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || optionsLoading}}">保存排班</button>
    <button bindtap="back" disabled="{{busy}}">返回核对列表</button>
  </block>
</view>
