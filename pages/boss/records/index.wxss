@import "../../../styles/business-page.wxss";

.filters .heading { margin-bottom: 20rpx; }
.filters input, .filters picker > view { padding: 24rpx; background: var(--yc-background); border-radius: 14rpx; line-height: 1.6; overflow-wrap: anywhere; }
.filters input { min-height: 64rpx; }
.filters .row { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.filters .row picker { flex: 1; min-width: 0; padding: 16rpx 8rpx; text-align: center; font-size: 28rpx; border: 1rpx solid var(--yc-border); border-radius: 12rpx; }
.actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.actions button { flex: 1; margin: 0; min-height: 96rpx; line-height: 96rpx; padding: 0 12rpx; }
button { margin-top: 20rpx; }
.result-summary { margin: 32rpx 0 24rpx; }
.pending-filters { margin-top: 16rpx; padding: 20rpx; border-radius: 14rpx; background: var(--yc-primary-soft); color: var(--yc-primary); font-size: 28rpx; line-height: 1.7; }
.record-title { overflow-wrap: anywhere; margin-bottom: 20rpx; }
.arrow { float: right; color: var(--yc-primary); margin-left: 16rpx; }
.record-field { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 24rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--yc-border); line-height: 1.7; font-size: 30rpx; }
.record-field > text { min-width: 0; overflow-wrap: anywhere; }
.record-field > text:first-child { color: var(--yc-muted); }
.record-field > text:last-child { text-align: right; font-variant-numeric: tabular-nums; }
.record-field:last-child { border-bottom: 0; }
.hint { margin-top: 12rpx; overflow-wrap: anywhere; }
