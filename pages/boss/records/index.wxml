<view class="page yc-page">
  <page-heading eyebrow="经营管理" title="{{title || '经营记录'}}" description="先选择门店、日期和条件，再查看业务记录。" />
  <view wx:if="{{!invalidEntry}}" class="card filters">
    <view class="heading">查询范围</view>
    <picker wx:if="{{depts.length}}" range="{{depts}}" range-key="name" value="{{deptIndex}}" bindchange="department" disabled="{{loading}}"><view class="row">门店：{{depts[deptIndex].name}}</view></picker>
    <input wx:if="{{searchLabel}}" value="{{keyword}}" bindinput="input" disabled="{{loading}}" placeholder="按{{searchLabel}}查询" />
    <view class="row"><picker mode="date" value="{{start}}" data-key="start" bindchange="date" disabled="{{loading}}">{{start || '开始日期'}}</picker><text>至</text><picker mode="date" value="{{end}}" data-key="end" bindchange="date" disabled="{{loading}}">{{end || '结束日期'}}</picker></view>
    <view class="actions"><button type="primary" bindtap="search" disabled="{{loading}}" loading="{{loading}}">查询</button><button bindtap="clear" disabled="{{loading}}">重置</button></view>
  </view>
  <button wx:if="{{canCreateCommission}}" type="primary" bindtap="commissionCreate">新增返佣盘点</button>
  <button wx:if="{{canCreate}}" type="primary" bindtap="create">新增{{title}}</button>
  <button wx:if="{{canExport}}" bindtap="exportCsv" disabled="{{loading || exporting}}" loading="{{exporting}}">导出当前结果 CSV（最多2000行）</button>
  <button wx:if="{{hasExport}}" bindtap="shareCsv">发送当前结果 CSV 文件</button>
  <view wx:if="{{error}}" class="card error">{{error}}<button wx:if="{{!invalidEntry}}" bindtap="search" disabled="{{loading}}">重试读取</button><button bindtap="backToWorkspace">返回工作台</button></view>
  <view wx:if="{{loaded}}" class="result-summary"><view class="heading">已加载 {{rows.length}} / {{total}} 条</view><view class="hint">{{appliedSummary}}</view><view wx:if="{{filtersDirty}}" class="pending-filters">条件已修改，请点击查询更新结果；翻页和导出仍使用上次查询范围。</view></view>
  <view wx:for="{{rows}}" wx:for-item="record" wx:for-index="rowIndex" wx:key="key" class="card record-card" data-index="{{rowIndex}}" bindtap="open">
    <view class="heading record-title">{{record.title}} <text wx:if="{{record.canOpen}}" class="arrow">›</text></view>
    <view wx:for="{{record.fields}}" wx:key="key" class="record-field"><text>{{item.label}}</text><text>{{item.value}}</text></view>
  </view>
  <view wx:if="{{loading}}" class="card">正在读取账号可见范围内的记录…</view>
  <view wx:elif="{{loaded && !rows.length}}" class="card">所选范围内暂无记录</view>
  <button wx:if="{{loaded && rows.length < total}}" bindtap="more" disabled="{{loading}}" loading="{{loading}}">加载更多</button>
</view>
