<view class="page"><view wx:if="{{loading}}" class="card">正在读取…</view><block wx:else><view class="card"><view wx:for="{{fields}}" wx:for-item="field" wx:for-index="fieldIndex" wx:key="key" class="form-row"><view class="label">{{field.label}}{{field.required ? ' *' : ''}}</view><picker wx:if="{{field.kind === 'department' || field.kind === 'status'}}" range="{{field.options}}" range-key="name" value="{{field.selected}}" data-index="{{fieldIndex}}" bindchange="pick" disabled="{{busy || saved || uncertain}}"><view class="choice">{{field.selected >= 0 ? field.options[field.selected].name : '请选择'}}</view></picker><checkbox-group wx:elif="{{field.kind === 'departments'}}" data-key="{{field.key}}" bindchange="check"><label wx:for="{{field.options}}" wx:for-item="option" wx:key="id" class="option"><checkbox value="{{option.id}}" checked="{{option.checked}}" disabled="{{busy || saved || uncertain}}"/>{{option.name}}</label></checkbox-group><picker wx:elif="{{field.kind === 'date'}}" mode="date" value="{{values[field.key]}}" data-index="{{fieldIndex}}" bindchange="pick" disabled="{{busy || saved || uncertain}}"><view class="choice">{{values[field.key] || '请选择日期'}}</view></picker><input wx:else value="{{values[field.key]}}" password="{{field.kind === 'password'}}" maxlength="{{field.max}}" data-key="{{field.key}}" bindinput="input" disabled="{{busy || saved || uncertain}}" placeholder="请输入{{field.label}}"/></view></view><view wx:if="{{error}}" class="card error">{{error}}</view><view wx:if="{{notice}}" class="card">{{notice}}</view><button wx:if="{{fields.length && !saved && !uncertain}}" type="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">保存</button><button bindtap="back" disabled="{{busy}}">{{saved || uncertain ? '返回核对列表' : '返回'}}</button></block></view>
