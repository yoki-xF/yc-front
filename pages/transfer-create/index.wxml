<view class="page yc-page">
  <page-heading eyebrow="业务单据" title="票据调拨" description="确认接收门店及票据明细，保留双方确认流程。" scope-label="调入门店" dept-name="{{deptName}}" /><view wx:if="{{loading}}" class="card">正在读取门店…</view><block wx:else><view class="card"><view class="heading">调拨明细</view><view class="hint">只能选择当前账号有权限的调出门店；确认后才会变更库存。</view><picker range="{{sources}}" range-key="name" bindchange="chooseSource" disabled="{{busy || uncertain || editMode || saved}}"><view class="add">{{sourceIndex >= 0 ? sources[sourceIndex].name : '选择调出门店'}}</view></picker><view wx:if="{{!sources.length}}" class="hint">当前账号没有其他可访问门店。</view><picker wx:if="{{sourceIndex >= 0}}" range="{{materials}}" range-key="materialName" bindchange="add" disabled="{{busy || uncertain || saved || conflict}}"><view class="add">选择票种 ＋</view></picker><view wx:for="{{items}}" wx:key="id" class="item"><view class="heading">{{item.name}} <text class="remove" data-index="{{index}}" bindtap="remove">移除</text></view><view class="hint">面值 {{item.money}} 元 · 单包 {{item.price}} 元 · 可用 {{item.availablePackages}} 包 / {{item.availableSheets}} 张</view><view class="line"><text>包数</text><input type="number" value="{{item.packages}}" data-index="{{index}}" data-field="packages" bindinput="input" disabled="{{busy || saved || conflict}}"/></view><view class="line"><text>张数</text><input type="number" value="{{item.sheets}}" data-index="{{index}}" data-field="sheets" bindinput="input" disabled="{{busy || saved || conflict}}"/></view></view><view class="hint">备注（选填）</view><textarea value="{{remark}}" bindinput="remark" maxlength="255" disabled="{{busy || saved || conflict}}"/><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{editMode && (conflict || error)}}" bindtap="reloadLatest" disabled="{{busy || loading}}">放弃草稿并加载最新单据</button><button wx:if="{{uncertain}}" bindtap="confirmChecked">已核对单据</button><button wx:if="{{saved}}" bindtap="back">返回详情</button><button type="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || uncertain || conflict || saved}}">{{editMode ? '保存修改' : '创建调拨单'}}</button></view></block></view>
