@import "../../styles/business-page.wxss";

.tabs { display: flex; gap: 12rpx; padding: 8rpx; margin-bottom: 24rpx; background: var(--yc-surface); border: 1rpx solid var(--yc-border); border-radius: 20rpx; }
.yc-page button.tab { flex: 1; min-width: 0; margin: 0; padding: 18rpx 12rpx; min-height: 88rpx; line-height: 1.6; font-size: 30rpx; text-align: center; color: var(--yc-muted); background: transparent; border: 2rpx solid transparent; border-radius: 14rpx; }
button.tab::after { border: 0; }
.yc-page button.tab.selected { color: var(--yc-primary); background: var(--yc-primary-soft); border-color: var(--yc-primary); font-weight: 600; }
.yc-page button.tab[disabled] { color: var(--yc-muted); opacity: .6; }
.heading { margin-bottom: 20rpx; overflow-wrap: anywhere; }
.hint { margin-top: 20rpx; }
.row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 20rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--yc-border); line-height: 1.6; overflow-wrap: anywhere; }
.row text:last-child { text-align: right; }
.row:last-child { border-bottom: 0; }
button { margin-top: 20rpx; }
