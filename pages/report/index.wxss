.page { padding: 32rpx; } .store { color: #526276; margin-bottom: 24rpx; } .tabs { display:flex; background:#fff; border-radius:16rpx; margin-bottom:24rpx; } .tab { flex:1; padding:24rpx 0; text-align:center; color:#526276; border-bottom:4rpx solid transparent; } .selected { color:#1677d2; border-color:#1677d2; font-weight:600; } .card { margin-bottom:24rpx; padding:28rpx; background:white; border-radius:16rpx; } .heading { font-size:32rpx; font-weight:600; } .hint,.empty { color:#647184; margin-top:20rpx; font-size:26rpx; } .row { display:grid; grid-template-columns: 1.4fr 1fr 1fr; gap:12rpx; padding:22rpx 0; border-bottom:1rpx solid #edf0f4; word-break:break-all; } .row text:not(:first-child) { text-align:right; } .share { grid-template-columns:1fr 1fr; } .error { color:#b42318; } button { margin-top:20rpx; }

.metric { text-align:right; min-width:0; } .track { height:8rpx; margin-top:8rpx; background:#edf3f9; border-radius:8rpx; overflow:hidden; } .bar { height:100%; background:#1677d2; border-radius:8rpx; } .bar.secondary { background:#60b27a; }
