<view class="page"><view class="store">当前门店：{{deptName}}</view><view class="tabs"><view wx:for="{{tabs}}" wx:key="index" data-tab="{{index}}" bindtap="changeTab" class="tab {{tab === index ? 'selected' : ''}}">{{item}}</view></view>
<view wx:if="{{loading}}" class="card">正在读取已结店日报…</view><view wx:elif="{{error}}" class="card error">{{error}}<button size="mini" bindtap="retry">重试</button></view>
<block wx:elif="{{report}}"><view class="card"><view class="heading">{{report.start}} 至 {{report.end}}</view><view>已结店 {{report.freshDays}} 天，其余 {{report.pendingDays}} 天暂无已结店日报</view><view class="hint">仅汇总已核对结店的日报；未完成日期不计入销量。</view></view>
<view class="card"><view class="heading">门店销量（元）</view><block wx:if="{{report.store}}"><view>即开 {{report.store.instant}}</view><view>电彩 {{report.store.electronic}}</view><view>竞彩 {{report.store.sportsBetting}}</view><view>合计 {{report.store.total}}</view></block><view wx:else>暂无已结店日报</view></view>
<view class="card"><view class="heading">我的销量（元）</view><block wx:if="{{report.personal}}"><view>电彩 {{report.personal.electronic}}</view><view>竞彩 {{report.personal.sportsBetting}}</view></block><view wx:else>暂无已结店日报</view></view>
<view wx:if="{{tab === 2}}" class="card"><view class="heading">月目标</view><view wx:if="{{report.target.configured}}">目标 {{report.target.amount}} 元；进度 {{report.target.progressPercent == null ? '—' : report.target.progressPercent + '%'}}（按已结店销量，百分比保留两位）</view><view wx:else>未配置月目标</view></view>
<view class="card"><view class="heading">每日覆盖</view><view wx:for="{{report.days}}" wx:key="businessDate" class="row"><text>{{item.businessDate}}</text><text>{{item.status === 'FRESH' ? '已结店' : item.status === 'OPEN' ? '营业中' : item.status === 'STALE' ? '待核对' : '未开店'}}</text></view></view></block></view>
