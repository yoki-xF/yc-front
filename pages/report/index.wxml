<view class="page yc-page">
  <page-heading eyebrow="经营报表" title="销量报表" description="个人仅统计电彩和竞彩；即开销量归门店汇总。" scope-label="当前门店" dept-name="{{deptName}}" /><view class="tabs"><button wx:for="{{tabs}}" wx:key="index" data-tab="{{index}}" bindtap="changeTab" disabled="{{invalidEntry}}" aria-label="{{item + (tab === index ? '，已选中' : '')}}" class="tab {{tab === index ? 'selected' : ''}}">{{item}}</button></view>
<view wx:if="{{loading}}" class="card">正在读取已结店日报…</view><view wx:elif="{{error}}" class="card error">{{error}}<button wx:if="{{!invalidEntry}}" type="primary" bindtap="retry">重新读取报表</button><button bindtap="backToWorkspace">返回工作台</button></view>
<block wx:elif="{{report}}"><view class="card"><view class="heading">{{report.start}} 至 {{report.end}}</view><view>已结店 {{report.freshDays}} 天，其余 {{report.pendingDays}} 天暂无已结店日报</view><view class="hint">仅汇总已核对结店的日报；未完成日期不计入销量。</view></view>
<view class="card"><view class="heading">门店销量（元）</view><block wx:if="{{report.store}}"><view class="report-metric"><text>即开</text><text>{{report.store.instant}}</text></view><view class="report-metric"><text>电彩</text><text>{{report.store.electronic}}</text></view><view class="report-metric"><text>竞彩</text><text>{{report.store.sportsBetting}}</text></view><view class="report-metric"><text>合计</text><text>{{report.store.total}}</text></view></block><view wx:else>暂无已结店日报</view></view>
<view class="card"><view class="heading">我的销量（元）</view><block wx:if="{{report.personal}}"><view class="report-metric"><text>电彩</text><text>{{report.personal.electronic}}</text></view><view class="report-metric"><text>竞彩</text><text>{{report.personal.sportsBetting}}</text></view></block><view wx:else>暂无已结店日报</view></view>
<view wx:if="{{tab === 2}}" class="card"><view class="heading">月目标</view><view wx:if="{{report.target.configured}}">目标 {{report.target.amount}} 元；进度 {{report.target.progressPercent == null ? '—' : report.target.progressPercent + '%'}}（按已结店销量，百分比保留两位）</view><view wx:else>未配置月目标</view></view>
<view class="card"><view class="heading">每日覆盖</view><view wx:for="{{report.days}}" wx:key="businessDate" class="row"><text>{{item.businessDate}}</text><text>{{item.status === 'FRESH' ? '已结店' : item.status === 'OPEN' ? '营业中' : item.status === 'STALE' ? '待核对' : '未开店'}}</text></view></view></block></view>
