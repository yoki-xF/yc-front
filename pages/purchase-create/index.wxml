<view class="page yc-page">
  <page-heading eyebrow="业务单据" title="采购入库" description="核对票种、数量和采购金额后提交。" dept-name="{{deptName}}" /><view wx:if="{{loading}}" class="card">正在读取票种…</view><view wx:elif="{{error && !materials.length}}" class="card error">{{error}}<button size="mini" bindtap="retry">重试</button></view><block wx:else><view class="card"><view class="heading">订票明细</view><view class="hint">{{editMode ? '编辑待确认单不会增加库存，确认入库后才会增加库存。' : '创建后为待确认状态，确认入库后才会增加库存。'}}</view><picker range="{{materials}}" range-key="materialName" bindchange="add" disabled="{{busy || saved}}"><view class="add">选择票种 ＋</view></picker><view wx:if="{{!items.length}}" class="hint">请添加票种。</view><view wx:for="{{items}}" wx:key="id" class="item"><view class="heading">{{item.name}} <text class="remove" data-index="{{index}}" bindtap="remove">移除</text></view><view class="hint">面值 {{item.money}} 元 · 单包 {{item.price}} 元</view><view class="line"><text>包数</text><input type="number" value="{{item.packages}}" data-index="{{index}}" data-field="packages" bindinput="input" disabled="{{busy || saved}}"/></view><view class="line"><text>张数</text><input type="number" value="{{item.sheets}}" data-index="{{index}}" data-field="sheets" bindinput="input" disabled="{{busy || saved}}"/></view></view><view class="line"><text>预计总金额</text><text>{{total}} 元</text></view><view class="hint">备注（选填，最多 255 字）</view><textarea value="{{remark}}" bindinput="remark" maxlength="255" disabled="{{busy || saved}}" placeholder="请输入备注"/><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{editMode && (conflict || error)}}" bindtap="reloadLatest" disabled="{{busy || loading}}">放弃草稿并加载最新单据</button><button wx:if="{{uncertain}}" bindtap="confirmChecked">已核对单据</button><button wx:if="{{saved}}" bindtap="back">返回详情</button><button type="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || uncertain || conflict || saved}}">{{editMode ? '保存修改' : '创建订票单'}}</button></view></block></view>
