<view class="page"><view class="store">当前门店：{{deptName}}</view><view wx:if="{{loading}}" class="card">正在读取详情…</view><view wx:elif="{{error && !order}}" class="card error">{{error}}<button size="mini" bindtap="retry">重试</button></view><block wx:elif="{{order}}"><view class="card"><view class="heading">{{order.number}}</view><view class="row"><text>状态</text><text>{{order.status}}</text></view><view class="row"><text>总金额</text><text>{{order.amount}} 元</text></view><view class="row"><text>建单人</text><text>{{order.userName}}</text></view><view wx:if="{{order.exDeptName}}" class="row"><text>调出门店</text><text>{{order.exDeptName}}</text></view><view wx:if="{{type === 'transfer' && order.targetName}}" class="row"><text>调入门店</text><text>{{order.targetName}}</text></view><view wx:if="{{order.remark}}" class="hint">备注：{{order.remark}}</view></view><view class="heading">票据明细</view><view wx:if="{{!items.length}}" class="card">暂无明细</view><view wx:for="{{items}}" wx:key="id" class="card"><view class="heading">{{item.name}}</view><view class="row"><text>面值</text><text>{{item.money}} 元</text></view><view class="row"><text>单包价格</text><text>{{item.price}} 元</text></view><view class="row"><text>数量</text><text>{{item.packages}} 包 / {{item.sheets}} 张</text></view><view class="row"><text>金额</text><text>{{item.amount}} 元</text></view></view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{uncertain}}" bindtap="retry" disabled="{{loading || busy}}">刷新单据</button><button wx:if="{{uncertain}}" bindtap="confirmChecked">已核对单据和库存</button><block wx:if="{{type === 'purchase' && order.stat === 0}}"><button bindtap="edit" disabled="{{busy || uncertain}}">编辑待确认单</button><button type="primary" data-action="confirm" bindtap="transition" loading="{{busy}}" disabled="{{busy || uncertain}}">确认入库</button><button data-action="cancel" bindtap="transition" disabled="{{busy || uncertain}}">作废单据</button></block><block wx:if="{{type === 'transfer' && order.nativeTransfer && order.stat === 0}}"><button wx:if="{{order.direction === 'in'}}" bindtap="edit" disabled="{{busy || uncertain}}">编辑待确认单</button><button wx:if="{{order.direction === 'out'}}" type="primary" data-action="confirm" bindtap="transition" loading="{{busy}}" disabled="{{busy || uncertain}}">确认调出</button><button wx:if="{{order.direction === 'in'}}" data-action="cancel" bindtap="transition" disabled="{{busy || uncertain}}">作废单据</button></block></block></view>
