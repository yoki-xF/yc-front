<view class="workspace">
  <view class="ws-header"><view class="ws-eyebrow">易彩 · 门店管理</view><view class="ws-title">今日营业</view><view class="ws-subtitle">盘点、记账与单据，围绕当前门店有序办理。</view></view>
  <view wx:if="{{!session}}" class="ws-card"><view class="ws-section">欢迎使用</view><view class="ws-note">使用管理员开通的账号登录。</view><button class="ws-primary" type="primary" bindtap="login">登录账号</button></view>
  <block wx:else>
    <view wx:if="{{loading}}" class="ws-card ws-note">正在读取账号与门店…</view>
    <view wx:elif="{{error}}" class="ws-card"><view class="ws-error">{{error}}</view><button wx:if="{{sessionExpired}}" class="ws-primary" bindtap="relogin">重新登录</button><button wx:else bindtap="retry">重试读取</button></view>
    <block wx:elif="{{user}}">
      <view class="ws-eyebrow">{{session.tenantName}} · {{user.nickname}}</view>
      <picker wx:if="{{deptIndex >= 0}}" range="{{depts}}" range-key="name" value="{{deptIndex}}" bindchange="changeDept"><view class="ws-scope"><view class="ws-scope-name"><text>{{depts[deptIndex].name}}</text><text class="ws-link">切换门店 ›</text></view><view class="ws-subtitle">所有营业操作以服务端绑定的营业日为准</view></view></picker>
      <view wx:else class="ws-card ws-note">当前账号没有可选择的门店，请联系管理员。</view>
      <block wx:if="{{deptIndex >= 0}}">
        <view class="ws-section">营业任务</view>
        <view class="ws-grid">
          <button class="ws-tile" bindtap="morning"><view class="ws-tile-mark">开班核对</view><view class="ws-tile-title">早盘点</view><view class="ws-tile-description">即开库存与期初资金</view></button>
          <button class="ws-tile" bindtap="business"><view class="ws-tile-mark">营业记录</view><view class="ws-tile-title">营业记账</view><view class="ws-tile-description">销量、兑奖与支出</view></button>
          <button class="ws-tile" bindtap="evening"><view class="ws-tile-mark">库存核对</view><view class="ws-tile-title">晚盘点</view><view class="ws-tile-description">核对门店即开库存</view></button>
          <button class="ws-tile" bindtap="fund"><view class="ws-tile-mark">余额核对</view><view class="ws-tile-title">资金盘点</view><view class="ws-tile-description">五类资金与笔数</view></button>
        </view>
        <button class="ws-row" bindtap="checkStatus"><view class="ws-row-label"><text>查看当天盘点进度</text><text>›</text></view></button>
        <view class="ws-section">单据与活动</view>
        <view class="ws-card"><button class="ws-row" bindtap="orders"><view class="ws-row-label"><text>即开票单据</text><text>›</text></view><view class="ws-tile-description">采购入库、票据调拨与确认</view></button><button class="ws-row" bindtap="cashTransfer"><view class="ws-row-label"><text>备付金转入</text><text>›</text></view></button><button class="ws-row" bindtap="activity"><view class="ws-row-label"><text>促销活动</text><text>›</text></view></button></view>
        <view class="ws-section">本月销量 · 已结店</view>
        <view wx:if="{{salesLoading}}" class="ws-card ws-note">正在读取销量…</view>
        <view wx:elif="{{salesError}}" class="ws-card"><view class="ws-error">{{salesError}}</view><button wx:if="{{salesExpired}}" bindtap="relogin">重新登录</button><button wx:else bindtap="retrySales">重试读取销量</button></view>
        <block wx:elif="{{sales}}">
          <view class="ws-card ws-feature"><view class="ws-eyebrow">我的销量</view><view class="ws-metrics"><view><view class="ws-subtitle">电彩</view><text class="ws-metric-value">{{sales.personal ? sales.personal.electronic : '—'}}</text></view><view><view class="ws-subtitle">竞彩</view><text class="ws-metric-value">{{sales.personal ? sales.personal.sportsBetting : '—'}}</text></view></view><view class="ws-subtitle">个人只看电彩和竞彩，不分摊门店盈亏。</view></view>
          <view class="ws-card"><view class="ws-eyebrow">门店销量 · 元</view><view class="ws-metrics"><view><view class="ws-subtitle">即开</view><text class="ws-metric-value">{{sales.store ? sales.store.instant : '—'}}</text></view><view><view class="ws-subtitle">电彩</view><text class="ws-metric-value">{{sales.store ? sales.store.electronic : '—'}}</text></view><view><view class="ws-subtitle">竞彩</view><text class="ws-metric-value">{{sales.store ? sales.store.sportsBetting : '—'}}</text></view><view><view class="ws-subtitle">门店合计</view><text class="ws-metric-value">{{sales.store ? sales.store.total : '—'}}</text></view></view><view class="ws-note">本月已结店 {{sales.freshDays}} 天，其余 {{sales.pendingDays}} 天暂无已结店日报</view><view class="ws-note">月目标：{{sales.target.configured ? sales.target.amount : '未配置'}} · 进度 {{sales.target.progressPercent == null ? '—' : sales.target.progressPercent}}%</view></view>
        </block>
        <button class="ws-row" bindtap="report"><view class="ws-row-label"><text>查看销量报表</text><text>›</text></view></button>
      </block>
    </block>
    <view class="ws-section">我的与帮助</view>
    <view class="ws-card"><button class="ws-row" bindtap="inbox"><view class="ws-row-label"><text>我的消息</text><text>›</text></view></button><button class="ws-row" bindtap="profile"><view class="ws-row-label"><text>个人资料</text><text>›</text></view></button><button class="ws-row" bindtap="manual"><view class="ws-row-label"><text>使用手册</text><text>›</text></view></button><button class="ws-row" bindtap="contact"><view class="ws-row-label"><text>联系客服</text><text>›</text></view></button></view>
    <view class="ws-footer"><button class="ws-row ws-quiet" bindtap="logout">退出当前账号</button></view>
  </block>
</view>
<boss-entry />
