.container { padding: 48rpx 32rpx; } .title { font-size: 40rpx; font-weight: 600; margin-bottom: 36rpx; } .card { background: #fff; border-radius: 20rpx; padding: 36rpx; } .heading { font-size: 32rpx; font-weight: 600; } .description { color: #647184; line-height: 1.7; margin-top: 16rpx; } .error { color: #b42318; margin-top: 20rpx; } button { margin-top: 30rpx; }
.store { margin-top: 24rpx; padding: 22rpx; background: #f3f6fa; border-radius: 12rpx; } .change { float: right; color: #1677d2; }
.sales { margin-top: 32rpx; border-top: 1rpx solid #e8edf3; padding-top: 28rpx; } .sales-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22rpx; margin-top: 24rpx; color: #647184; } .sales-grid text { display: block; color: #1c2735; font-weight: 600; margin-top: 8rpx; }
