<view class="page yc-page">
  <page-heading eyebrow="营业任务" title="盘点进度" description="查看当前门店的实际盘点状态，未完成不显示为已完成。" scope-label="当前门店" dept-name="{{deptName}}" /><view class="card"><view class="heading">盘点进度</view><view wx:if="{{loading}}" class="hint">正在读取状态…</view><view wx:if="{{error}}" class="error">{{error}}<button size="mini" bindtap="retry" disabled="{{loading}}">重试</button></view><view wx:if="{{ready}}"><view wx:for="{{rows}}" wx:key="key" class="row" data-key="{{item.key}}" bindtap="open"><text>{{item.name}}</text><text class="state">{{item.state}}{{item.enabled ? ' ›' : ''}}</text></view><view class="hint">状态仅表示是否存在记录；请进入页面核对具体内容。完成盘点后，由有权限人员核对结店。</view><button bindtap="retry" disabled="{{loading}}">刷新状态</button></view></view></view>
