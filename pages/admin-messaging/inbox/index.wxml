<view class="page yc-page"><page-heading eyebrow="我的消息" title="站内消息" description="查看业务通知，阅读状态以服务端保存结果为准。" /><view class="heading">我的消息 · {{unread}} 条未读</view><view wx:if="{{error}}" class="card error">{{error}}<button bindtap="retry" disabled="{{loading || busy}}">刷新</button></view><button bindtap="readAll" disabled="{{loading || busy || !unread}}">全部标记已读</button><view wx:for="{{rows}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="read"><view class="{{item.read ? '' : 'unread'}}">{{item.title}} · {{item.read ? '已读' : '未读'}}</view><view class="content">{{item.content}}</view><view class="hint">{{item.createTime}}</view></view><view wx:if="{{loading}}" class="card">读取中…</view><view wx:if="{{!loading && !rows.length}}" class="card">暂无消息</view><view class="pagination"><button bindtap="previous" disabled="{{loading || busy || pageNo <= 1}}">上一页</button><text>第 {{pageNo}} 页</text><button bindtap="next" disabled="{{loading || busy || pageNo * 20 >= total}}">下一页</button></view></view>
