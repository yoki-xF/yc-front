<view class="page"><view class="heading">地区查询</view><view wx:if="{{error}}" class="card error">{{error}}</view><view class="card"><input value="{{ip}}" bindinput="input" placeholder="输入IP地址" maxlength="45"/><button bindtap="locate" disabled="{{loading}}">查询归属地区</button><view wx:if="{{ipResult}}">{{ipResult}}</view></view><view class="card"><view>当前位置：{{trail.length ? trail : '中国'}}</view><button wx:if="{{trail.length}}" bindtap="back">返回上一级</button><view wx:for="{{rows}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="open">{{item.name}} · {{item.id}} {{item.hasChildren ? ' ›' : ''}}</view><view wx:if="{{loading}}">读取中…</view></view></view>
