page{background:#f4f6fa;color:#172033}.page{padding:28rpx 24rpx 60rpx}.title{font-size:38rpx;font-weight:700;margin-bottom:20rpx}.hint,.small{font-size:25rpx;line-height:1.65;color:#65718a;margin:14rpx 0;word-break:break-all}.error{background:#fff0ee;color:#a42b21;padding:22rpx;border-radius:12rpx;line-height:1.6;margin:18rpx 0}.card{background:#fff;padding:26rpx;margin:22rpx 0;border-radius:18rpx}.name{font-size:32rpx;font-weight:600;word-break:break-all}.label{font-size:28rpx;font-weight:600;margin:26rpx 0 12rpx}input,textarea{box-sizing:border-box;background:#fff;border:1rpx solid #cbd3e0;border-radius:10rpx;padding:18rpx;width:100%;font-size:29rpx;margin:12rpx 0}input{height:86rpx}textarea{min-height:150rpx}.json{height:500rpx;font-family:monospace;font-size:25rpx}.line{display:flex;align-items:center;gap:18rpx}.line input{flex:1;width:40%}button{margin-top:20rpx;font-size:28rpx}.link{color:#1763cc;margin-top:16rpx}.grid{display:inline-block;margin-top:16rpx}.grid-row{display:flex}.row-label{width:55rpx;background:#edf1f7;text-align:center;flex-shrink:0;padding:10rpx 0}.cell{width:180rpx;min-height:65rpx;padding:10rpx;border:1rpx solid #d9dfeb;white-space:pre-wrap;word-break:break-all;flex-shrink:0;font-size:25rpx}
