<view class="page">
 <view class="title">积木报表 · 我的模板</view>
 <view class="hint">仅显示当前平台租户、当前账号创建且未删除的模板。无租户归属的旧模板不在目录中。</view>
 <view wx:if="capabilities.writeStorageAvailable===false" class="hint">积木存储与当前事务的数据源尚未确认一致，原生管理当前只读。</view>
 <view wx:if="error" class="error">{{error}}</view>
 <view wx:if="!form">
  <input value="{{keyword}}" bindinput="filterInput" placeholder="按模板名称搜索" maxlength="100" disabled="{{loading||busy}}" />
  <view class="line">仅模板 <switch checked="{{templatesOnly}}" bindchange="toggleTemplates" disabled="{{loading||busy}}" /></view>
  <button bindtap="search" loading="{{loading}}" disabled="{{loading||busy}}">搜索 / 刷新</button>
  <button wx:if="capabilities.create" bindtap="create" disabled="{{busy}}">新建静态模板</button>
  <button wx:if="capabilities.create" bindtap="importFile" disabled="{{busy}}">从 JSON 导入新模板草稿</button>
  <view wx:if="loaded&&!rows.length" class="hint">没有符合条件的模板</view>
  <view wx:for="{{rows}}" wx:key="id" class="card" bindtap="open" data-id="{{item.id}}"><view class="name">{{item.name}}</view><view class="small">编号 {{item.id}}</view><view class="small">类型 {{item.type}} · {{item.template==='0'?'模板':'报表'}}</view><view class="small">更新 {{item.updateTime}}</view><view class="link">打开详情 ›</view></view>
  <button wx:if="rows.length<total" bindtap="more" loading="{{loading}}" disabled="{{loading||busy}}">加载更多（{{rows.length}} / {{total}}）</button>
 </view>
 <view wx:else class="card">
  <view class="name">{{form.id?'模板详情':'新模板草稿'}}</view><view wx:if="form.id" class="small">编号 {{form.id}}</view>
  <view class="label">模板名称</view><input value="{{form.name}}" data-key="name" bindinput="input" maxlength="100" disabled="{{busy||unknown||conflict||form.metadataAvailable===false}}" />
  <view class="label">说明</view><textarea value="{{form.note}}" data-key="note" bindinput="input" maxlength="500" disabled="{{busy||unknown||conflict||form.metadataAvailable===false}}" />
  <view wx:if="form.metadataAvailable===false" class="error">名称或说明包含不支持的内容，已隐藏。此模板在原生页只读。</view>
  <view class="hint">{{form.limitation||'只支持静态文字和基础表格配置，保存后可由原积木报表读取。'}}</view>
  <view wx:if="form.configurationAvailable">
   <view class="label">编辑单元格（行列从 1 开始）</view>
   <view class="line"><input type="number" value="{{cellRow}}" data-key="cellRow" bindinput="cellInput" placeholder="行" disabled="{{busy||unknown||conflict||form.metadataAvailable===false}}"/><input type="number" value="{{cellCol}}" data-key="cellCol" bindinput="cellInput" placeholder="列" disabled="{{busy||unknown||conflict||form.metadataAvailable===false}}"/></view>
   <textarea value="{{cellText}}" data-key="cellText" bindinput="cellInput" placeholder="静态文字" maxlength="2000" disabled="{{busy||unknown||conflict||form.metadataAvailable===false}}"/>
   <view class="line"><input type="number" value="{{rowHeight}}" data-key="rowHeight" bindinput="cellInput" placeholder="行高 10–500" disabled="{{busy||unknown||conflict||form.metadataAvailable===false}}"/><input type="number" value="{{colWidth}}" data-key="colWidth" bindinput="cellInput" placeholder="列宽 20–1000" disabled="{{busy||unknown||conflict||form.metadataAvailable===false}}"/></view>
   <button bindtap="applyCell" disabled="{{busy||unknown||conflict||form.metadataAvailable===false}}">应用到本地草稿</button>
   <button bindtap="toggleJson" disabled="{{busy||unknown}}">{{showJson?'收起':'展开'}}配置 JSON</button>
   <textarea wx:if="showJson" class="json" value="{{form.configuration}}" data-key="configuration" bindinput="input" maxlength="131072" disabled="{{busy||unknown||conflict||form.metadataAvailable===false}}"/>
   <button bindtap="preview" disabled="{{busy||unknown}}">检查并刷新静态内容预览</button>
   <view class="hint">只预览前 20 行、10 列文字；样式、合并和打印分页以原设计器为准。</view>
   <scroll-view scroll-x><view class="grid"><view class="grid-row" wx:for="{{grid}}" wx:key="row" wx:for-item="row"><view class="row-label">{{row.row}}</view><view class="cell" wx:for="{{row.cells}}" wx:key="key" wx:for-item="cell">{{cell.text}}</view></view></view></scroll-view>
  </view>
  <button wx:if="!form.id&&capabilities.create||form.id&&capabilities.update" type="primary" bindtap="save" loading="{{busy}}" disabled="{{busy||unknown||conflict||form.metadataAvailable===false}}">{{form.id?'确认保存修改':'确认创建模板'}}</button>
  <button wx:if="unknown" bindtap="reconcile" disabled="{{busy}}">核对保存结果</button>
  <button wx:if="form.id&&form.configurationAvailable&&form.metadataAvailable!==false&&capabilities.export" bindtap="exportFile" disabled="{{busy||unknown}}">导出已保存的静态配置</button>
  <button bindtap="close" disabled="{{busy||unknown}}">返回目录</button>
 </view>
 <view class="hint">原生页不执行数据查询、SQL、表达式或增强脚本。复杂电子表格排版、图表和打印设计仍需自托管浏览器设计器；本页不携带令牌跳转。</view>
</view>
