<block wx:if="{{deferred}}"><view class="page">支付功能已预留，待接入方案确定后再启用。</view></block><block wx:else><view class="page"><view class="error" wx:if="{{error}}">{{error}}</view><button bindtap="refresh">刷新</button><button wx:if="{{canCreate}}" bindtap="create">新增套餐</button><view wx:if="{{loaded && !rows.length}}">没有套餐</view><view class="card" wx:for="{{rows}}" wx:key="id"><view>{{item.name}}（{{item.id}}）</view><view>支付 ¥{{item.payPrice}}　赠送 ¥{{item.bonusPrice}}　状态 {{item.status}}</view><button wx:if="{{canUpdate}}" size="mini" data-index="{{index}}" bindtap="edit">编辑</button><button wx:if="{{canDelete}}" size="mini" data-index="{{index}}" bindtap="remove">删除</button></view><button wx:if="{{rows.length < total}}" bindtap="more">加载更多</button><view class="card" wx:if="{{editing}}"><input placeholder="套餐名" value="{{form.name}}" data-key="name" bindinput="input"/><input placeholder="支付金额（元）" type="digit" value="{{form.payPrice}}" data-key="payPrice" bindinput="input"/><input placeholder="赠送金额（元）" type="digit" value="{{form.bonusPrice}}" data-key="bonusPrice" bindinput="input"/><radio-group bindchange="status"><label><radio value="0" checked="{{form.status === 0}}"/>启用</label><label><radio value="1" checked="{{form.status === 1}}"/>停用</label></radio-group><button bindtap="save" disabled="{{locked || loading}}">保存</button><button bindtap="cancel">取消</button></view></view>
</block>
