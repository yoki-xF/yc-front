<block wx:if="{{deferred}}"><view class="page">支付功能已预留，待接入方案确定后再启用。</view></block><block wx:else><view class="page"><button bindtap="refresh">刷新</button><view class="error" wx:if="{{error}}">{{error}}</view><view wx:if="{{loaded && !rows.length}}">没有通知任务</view><view class="card" wx:for="{{rows}}" wx:key="id"><view>任务：{{item.id}}　应用：{{item.appName}}</view><view>商户订单：{{item.merchantOrderId}}</view><view>类型：{{item.type}}　状态：{{item.status}}　次数：{{item.notifyTimes}}</view><view>下次通知：{{item.nextNotifyTime}}</view><button size="mini" data-id="{{item.id}}" bindtap="detail">详情与日志</button></view><button wx:if="{{rows.length < total}}" bindtap="more">加载更多</button><view wx:if="{{detail}}" class="card"><button bindtap="close">关闭详情</button><text selectable>{{detail}}</text></view></view>
</block>
