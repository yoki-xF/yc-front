<block wx:if="{{deferred}}"><view class="page">支付功能已预留，待接入方案确定后再启用。</view></block><block wx:else><view class="page"><view class="error" wx:if="{{error}}">{{error}}</view><view wx:if="{{locked}}" class="error">操作结果未知，已锁定写入，请核对后联系管理员。</view><button bindtap="refresh">刷新</button><button wx:if="{{canCreate}}" bindtap="create" disabled="{{locked}}">新增应用</button><view wx:if="{{loaded && !rows.length}}">没有应用</view><view class="card" wx:for="{{rows}}" wx:key="id"><view>{{item.name}}（{{item.appKey}}）</view><view>编号 {{item.id}}　状态 {{item.status === 0 ? '启用' : '停用'}}</view><button wx:if="{{canUpdate}}" size="mini" data-index="{{index}}" bindtap="edit">编辑</button><button wx:if="{{canChannel}}" size="mini" data-index="{{index}}" bindtap="channel">渠道</button><button wx:if="{{canDelete}}" size="mini" data-index="{{index}}" bindtap="remove">删除</button></view><button wx:if="{{rows.length < total}}" bindtap="more">加载更多</button><view class="card" wx:if="{{editing}}"><input placeholder="应用名" value="{{form.name}}" data-key="name" bindinput="input"/><input placeholder="应用标识" value="{{form.appKey}}" data-key="appKey" bindinput="input"/><input placeholder="支付结果回调地址" value="{{form.orderNotifyUrl}}" data-key="orderNotifyUrl" bindinput="input"/><input placeholder="退款结果回调地址" value="{{form.refundNotifyUrl}}" data-key="refundNotifyUrl" bindinput="input"/><view wx:if="{{form.transferNotifyUrl}}">转账回调地址（只读）：{{form.transferNotifyUrl}}</view><input placeholder="备注" value="{{form.remark}}" data-key="remark" bindinput="input"/><radio-group bindchange="status"><label><radio value="0" checked="{{form.status === 0}}"/>启用</label><label><radio value="1" checked="{{form.status === 1}}"/>停用</label></radio-group><button bindtap="save" disabled="{{locked || loading}}">保存</button><button bindtap="cancel">取消</button></view></view>
</block>
