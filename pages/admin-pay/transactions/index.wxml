<block wx:if="{{deferred}}"><view class="page">支付功能已预留，待接入方案确定后再启用。</view></block><block wx:else><view class="page"><view class="heading">{{title}}</view><view class="hint">状态以服务端记录为准。编号精度不足时不能打开详情。</view><input placeholder="输入商户单号" value="{{keyword}}" bindinput="input"/><view class="filters"><input placeholder="应用编号（可选）" value="{{filters.appId}}" data-key="appId" bindinput="filter"/><input placeholder="渠道编码（可选，如 wx_lite）" value="{{filters.channelCode}}" data-key="channelCode" bindinput="filter"/><input placeholder="状态码（可选）" value="{{filters.status}}" data-key="status" bindinput="filter" type="number"/><input wx:if="{{kind !== 'refund'}}" placeholder="平台单号（可选）" value="{{filters.no}}" data-key="no" bindinput="filter"/><input wx:if="{{kind !== 'transfer'}}" placeholder="渠道支付单号（可选）" value="{{filters.channelOrderNo}}" data-key="channelOrderNo" bindinput="filter"/><block wx:if="{{kind === 'refund'}}"><input placeholder="商户退款单号" value="{{filters.merchantRefundId}}" data-key="merchantRefundId" bindinput="filter"/><input placeholder="渠道退款单号" value="{{filters.channelRefundNo}}" data-key="channelRefundNo" bindinput="filter"/></block><block wx:if="{{kind === 'transfer'}}"><input placeholder="转账类型码" value="{{filters.type}}" data-key="type" bindinput="filter"/><input placeholder="收款人姓名" value="{{filters.userName}}" data-key="userName" bindinput="filter"/><input placeholder="渠道转账单号" value="{{filters.channelTransferNo}}" data-key="channelTransferNo" bindinput="filter"/></block><picker mode="date" value="{{filters.start}}" data-key="start" bindchange="filter"><view>创建开始日期：{{filters.start || '未选择'}}</view></picker><picker mode="date" value="{{filters.end}}" data-key="end" bindchange="filter"><view>创建结束日期：{{filters.end || '未选择'}}</view></picker></view><button bindtap="search" disabled="{{loading}}">查询 / 刷新</button><view wx:if="{{queryDirty}}">筛选已修改，请先查询。</view><button bindtap="clearFilters" disabled="{{loading}}">清空筛选</button><button wx:if="{{canExport}}" bindtap="exportCsv" disabled="{{loading || exporting || queryDirty}}">导出当前查询 CSV（最多2000条）</button><button wx:if="{{hasExport}}" bindtap="shareCsv">分享已导出的文件</button><view class="error" wx:if="{{error}}">{{error}}</view><view wx:if="{{loaded && !rows.length}}">没有记录</view><view class="card" wx:for="{{rows}}" wx:key="id"><view>{{item.title}}</view><view>状态：{{item.status}}　金额：{{item.amount}} 元</view><view wx:if="{{item.unsafe}}">编号精度不足，请在安全管理端查看</view><button wx:else size="mini" data-id="{{item.id}}" bindtap="detail">查看详情</button></view><button wx:if="{{rows.length < total}}" bindtap="more" disabled="{{loading}}">加载更多</button><view wx:if="{{detail}}" class="card"><button bindtap="close">关闭详情</button><button wx:if="{{kind === 'order' && canSync}}" bindtap="sync">同步订单状态</button><view wx:for="{{detail}}" wx:key="key"><text>{{item.label}}： </text><text selectable>{{item.value}}</text></view></view></view>
</block>
