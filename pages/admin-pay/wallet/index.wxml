<block wx:if="{{deferred}}"><view class="page">支付功能已预留，待接入方案确定后再启用。</view></block><block wx:else><view class="page"><view class="tabs"><button size="mini" data-kind="wallet" bindtap="kind">钱包</button><button size="mini" data-kind="transaction" bindtap="kind">流水</button></view><input placeholder="用户编号（可选）" value="{{userId}}" data-key="userId" bindinput="input"/><input wx:if="{{kind === 'transaction'}}" placeholder="钱包编号（可选）" value="{{walletId}}" data-key="walletId" bindinput="input"/><button bindtap="search" loading="{{loading}}">查询</button><view class="error" wx:if="{{error}}">{{error}}</view><view wx:if="{{loaded && !rows.length}}">没有记录</view><view class="card" wx:for="{{rows}}" wx:key="id"><view>编号：{{item.id}}</view><view wx:if="{{kind === 'wallet'}}">用户：{{item.userId}}　余额：¥{{item.balance}}</view><view wx:if="{{kind === 'wallet'}}">累计支出：¥{{item.totalExpense}}　累计充值：¥{{item.totalRecharge}}　冻结：¥{{item.freezePrice}}</view><button wx:if="{{kind === 'wallet'}}" size="mini" data-id="{{item.id}}" bindtap="transactions">查看流水</button><view wx:else>{{item.title}}　金额：¥{{item.price}}　余额：¥{{item.balance}}</view><button wx:if="{{kind === 'wallet' && item.userType === 1 && canAdjust}}" size="mini" data-id="{{item.id}}" bindtap="adjust">会员钱包更正</button></view><button wx:if="{{rows.length < total}}" bindtap="more">加载更多</button></view>
</block>
