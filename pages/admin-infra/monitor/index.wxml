<view class="page"><view class="heading">{{title}}</view><input wx:if="{{docs}}" value="{{keyword}}" bindinput="input" placeholder="搜索接口路径或方法名" maxlength="100"/><button bindtap="refresh" disabled="{{loading}}">{{docs ? '查询 / 刷新' : '刷新指标'}}</button><view wx:if="{{loading}}" class="card">正在读取…</view><view wx:if="{{error}}" class="card error">{{error}}</view><view wx:for="{{rows}}" wx:key="key" class="card"><view>{{item.label}}</view><view class="value">{{item.value}}</view></view><view wx:for="{{pools}}" wx:key="index" class="card"><view class="heading">连接池 {{item.index + 1}}</view><view wx:for="{{item.fields}}" wx:for-item="field" wx:key="label" class="row"><text>{{field.label}}</text><text>{{field.value}}</text></view></view><view wx:if="{{title === '数据库连接池' &amp;&amp; !loading &amp;&amp; !available &amp;&amp; !error}}" class="card">当前服务未启用Druid连接池，暂无指标。</view><view wx:for="{{documents}}" wx:key="key" class="card"><view>{{item.summary || item.handler}}</view><view class="value">{{item.methodText}} {{item.path}}</view><view wx:for="{{item.parameters}}" wx:for-item="parameter" wx:key="name" class="hint value">{{parameter.name}}：{{parameter.type}}</view></view><view wx:if="{{docs}}" class="pagination"><button bindtap="previous" disabled="{{loading || pageNo &lt;= 1}}">上一页</button><text>{{pageNo}} 页 / {{total}} 项</text><button bindtap="next" disabled="{{loading || pageNo * 30 &gt;= total}}">下一页</button></view></view>
