<view class="page"><view class="heading">链路追踪</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{busy}}">正在读取…</view><view wx:if="{{configured === false}}" class="card">尚未配置自托管 SkyWalking。部署管理员配置 OAP 后可查询，不需要外部商业服务。</view><button bindtap="loadServices" disabled="{{busy}}">刷新服务目录</button><block wx:if="{{configured}}"><block wx:if="{{!spans}}"><picker range="{{services}}" range-key="name" value="{{serviceIndex}}" bindchange="select" disabled="{{busy}}"><view class="card">{{serviceIndex >= 0 ? services[serviceIndex].name : '点击选择服务'}}</view></picker><view>时间范围（UTC）</view><button wx:for="{{[15,60,360,1440]}}" wx:key="*this" size="mini" data-value="{{item}}" bindtap="range" disabled="{{busy || minutes === item}}">{{item}} 分钟</button><view>结果类型</view><button wx:for="{{['ALL','SUCCESS','ERROR']}}" wx:key="*this" size="mini" data-value="{{item}}" bindtap="state" disabled="{{busy || state === item}}">{{item === 'ALL' ? '全部' : item === 'SUCCESS' ? '成功' : '错误'}}</button><button bindtap="search" disabled="{{busy || serviceIndex &lt; 0}}">查询链路</button><view wx:for="{{rows}}" wx:key="segmentId" class="card" data-id="{{item.id}}" bindtap="open"><view>{{item.endpoint}}</view><view>{{item.start}} · {{item.duration}} ms · {{item.error ? '错误' : '成功'}}</view><view class="id">{{item.id}}</view><view>点击查看调用跨度</view></view><view wx:if="{{!busy &amp;&amp; !rows.length}}">暂无链路结果</view><button bindtap="previous" disabled="{{busy || pageNo &lt;= 1}}">上一页</button><view>第 {{pageNo}} 页，每页最多20条</view><button bindtap="next" disabled="{{busy || rows.length &lt; 20 || pageNo >= 100}}">下一页</button></block><block wx:else><view>调用跨度（最多300项，不读取标签与日志正文）</view><view wx:for="{{spans}}" wx:key="index" class="card"><view>{{item.service}} · {{item.type}}</view><view>{{item.endpoint}}</view><view>跨度 {{item.span}}，父跨度 {{item.parent}} · {{item.error ? '错误' : '成功'}}</view><view class="id">{{item.start}} → {{item.end}}</view></view><button bindtap="back" disabled="{{busy}}">返回链路列表</button></block></block></view>
