.page{padding:24rpx;font-size:30rpx;line-height:1.6;color:#172333}.title{font-size:34rpx;font-weight:600;margin:20rpx 0}.status{padding:20rpx;background:#e9f2ff;border-radius:12rpx;margin:18rpx 0}.error{color:#a00}input,textarea{box-sizing:border-box;width:100%;border:1px solid #8795a1;padding:16rpx;font-size:30rpx;margin:16rpx 0}textarea{height:240rpx}button{margin:16rpx 0}.card{border:1px solid #8795a1;border-radius:12rpx;padding:20rpx;margin:16rpx 0}text{white-space:pre-wrap;word-break:break-all}
