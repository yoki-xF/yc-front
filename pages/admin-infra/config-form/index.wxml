<view class="page"><view wx:if="{{loading}}">正在读取…</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!loading}}"><view wx:for="{{fields}}" wx:key="key" class="card"><view>{{item.label}}</view><input value="{{values[item.key]}}" password="{{item.secret}}" data-key="{{item.key}}" bindinput="input" disabled="{{saving}}"/></view><view class="card">可见 <switch checked="{{values.visible}}" bindchange="visible" disabled="{{saving}}"/></view><button bindtap="save" disabled="{{saving || unknown}}">{{saving ? '保存中…' : '保存'}}</button></view></view>
