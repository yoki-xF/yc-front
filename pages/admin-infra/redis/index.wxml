<view class="page"><button bindtap="load" disabled="{{loading}}">刷新</button><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}">正在读取…</view><view wx:for="{{rows}}" wx:key="label" class="card">{{item.label}}：{{item.value}}</view><view wx:if="{{loaded}}" class="card">命令累计调用（最多前 100 项）<view wx:for="{{commandStats}}" wx:key="name">{{item.name}}：{{item.calls}}</view><view wx:if="{{!commandStats.length}}">暂无命令统计</view></view></view>
