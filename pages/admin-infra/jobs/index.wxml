<view class="page"><view class="search"><input placeholder="任务名称" value="{{name}}" bindinput="input"/><button size="mini" bindtap="search" disabled="{{loading}}">查询</button><button size="mini" bindtap="create">新建任务</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}">正在读取…</view><view wx:if="{{loaded && !rows.length && !loading}}">暂无任务</view><view wx:for="{{rows}}" wx:key="id" class="card"><view class="title">{{item.name}}</view><view>处理器：{{item.handlerName}}</view><view>CRON：{{item.cronExpression}}</view><view>状态：{{item.status === 1 ? '运行中' : '已停止'}}</view><view class="actions"><button size="mini" data-id="{{item.id}}" bindtap="edit">编辑</button><button size="mini" data-id="{{item.id}}" bindtap="logs">日志</button><button size="mini" data-id="{{item.id}}" bindtap="next">下次执行</button><button size="mini" disabled="{{busy || unknown}}" data-id="{{item.id}}" data-revision="{{item.revision}}" data-action="status" data-status="{{item.status}}" bindtap="action">启停</button><button size="mini" disabled="{{busy || unknown}}" data-id="{{item.id}}" data-revision="{{item.revision}}" data-action="trigger" bindtap="action">立即执行</button><button size="mini" disabled="{{busy || unknown}}" data-id="{{item.id}}" data-revision="{{item.revision}}" data-action="delete" bindtap="action">删除</button></view></view><button wx:if="{{rows.length < total}}" bindtap="more" disabled="{{loading}}">加载更多</button></view>
