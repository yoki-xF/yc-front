.page{padding:24rpx;line-height:1.6}.title{font-size:34rpx;font-weight:bold}.card{border:1px solid #ddd;border-radius:12rpx;padding:20rpx;margin:20rpx 0}input{border:1px solid #aaa;padding:12rpx;margin:12rpx 0}button{margin:10rpx 4rpx}.error{color:#a00}label{display:block}text{white-space:pre-wrap;word-break:break-all}
.page{font-size:30rpx;color:#172333}textarea{width:100%;box-sizing:border-box;min-height:420rpx;border:1px solid #8795a1;padding:16rpx;margin:16rpx 0;font-size:28rpx;background:#fff}input{font-size:30rpx}.error{font-size:30rpx}

.layout-canvas{position:relative;width:600rpx;max-width:100%;border:2rpx solid #53687d;background:#eef2f7;overflow:hidden;margin:24rpx 0}.layout-item{position:absolute;box-sizing:border-box;border:2rpx solid #2265b5;background:rgba(206,225,247,.8);font-size:24rpx;overflow:hidden;color:#102c4d;min-height:12rpx}
