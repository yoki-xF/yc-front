<view class="page"><view class="title">GoView 项目</view><view>管理本人创建的项目和JSON配置。组件结构查看不执行脚本、不请求配置中的外部数据。</view><view class="error" wx:if="{{error}}">{{error}}</view><view wx:if="{{notice}}">{{notice}}</view><view wx:if="{{busy}}">正在处理…</view><block wx:if="{{form}}"><view>项目名称</view><input value="{{form.name}}" data-key="name" bindinput="input" disabled="{{busy || uncertain}}"/><block wx:if="{{form.id}}"><view>发布状态（0 已发布 / 1 未发布）</view><input value="{{form.status}}" data-key="status" bindinput="input" disabled="{{busy || uncertain}}"/><view>备注</view><input value="{{form.remark}}" data-key="remark" bindinput="input" disabled="{{busy || uncertain}}"/><view>项目配置 JSON（最多1MB）</view><textarea value="{{form.content}}" data-key="content" bindinput="input" maxlength="-1" disabled="{{busy || uncertain || !cap.update}}"/><button bindtap="inspect" disabled="{{busy}}">预览布局与编辑位置</button><block wx:if="{{canvas}}"><view>画布 {{canvas.width}} × {{canvas.height}}，点击组件编辑布局。此预览显示位置和名称；图表数据、脚本及外部资源不在此执行。</view><view class="layout-canvas" style="height:{{600 * canvas.height / canvas.width}}rpx"><view wx:for="{{canvas.items}}" wx:key="index" class="layout-item" style="{{item.style}}" data-index="{{item.index}}" bindtap="selectComponent">{{item.title}}</view></view><view wx:if="{{selected}}" class="card"><view>{{selected.title}}</view><block wx:for="{{['x','y','w','h']}}" wx:key="*this"><view>{{item}}</view><input value="{{selected[item]}}" data-key="{{item}}" bindinput="geometryInput" disabled="{{busy || uncertain || !cap.update}}"/></block><block wx:if="{{cap.update}}"><button data-action="geometry" bindtap="layoutAction" disabled="{{busy || uncertain}}">应用位置与尺寸</button><button data-action="duplicate" bindtap="layoutAction" disabled="{{busy || uncertain}}">复制组件</button><button data-action="front" bindtap="layoutAction" disabled="{{busy || uncertain}}">移到顶层</button><button data-action="back" bindtap="layoutAction" disabled="{{busy || uncertain}}">移到底层</button><button data-action="remove" bindtap="layoutAction" disabled="{{busy || uncertain}}">移除组件</button></block></view></block><view wx:for="{{components}}" wx:key="index" class="card"><view>{{item.index + 1}}. {{item.title}}</view><view>{{item.position}}</view></view><button bindtap="importFile" wx:if="{{cap.update}}" disabled="{{busy || uncertain}}">导入配置文件</button><button bindtap="exportFile" disabled="{{busy}}">导出当前配置</button></block><button wx:if="{{form.id ? cap.update : cap.create}}" bindtap="save" disabled="{{busy || uncertain}}">保存</button><button bindtap="close" disabled="{{busy}}">返回并重新查询</button></block><block wx:else><input placeholder="项目名称" value="{{keyword}}" bindinput="query"/><button bindtap="search" disabled="{{busy}}">查询</button><button wx:if="{{cap.create}}" bindtap="create" disabled="{{busy || uncertain}}">新建项目</button><view wx:for="{{rows}}" wx:key="id" class="card"><view>{{item.name}}（{{item.id}}）</view><view>{{item.status === 0 ? '已发布' : '未发布'}}　{{item.remark}}</view><button size="mini" data-id="{{item.id}}" bindtap="edit" disabled="{{busy}}">查看与编辑</button><button size="mini" wx:if="{{cap.delete && item.status === 1}}" data-id="{{item.id}}" bindtap="remove" disabled="{{busy || uncertain}}">删除</button></view><view wx:if="{{!rows.length && !busy && !error}}">暂无项目</view><button size="mini" bindtap="prev" disabled="{{busy || pageNo <= 1}}">上一页</button> 第 {{pageNo}} 页，共 {{total}} 条 <button size="mini" bindtap="next" disabled="{{busy || pageNo * 20 >= total}}">下一页</button></block></view>
