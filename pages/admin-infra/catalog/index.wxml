<view class="page"><view wx:if="{{searchable}}" class="search"><input value="{{keyword}}" placeholder="输入筛选条件" bindinput="input"/><button size="mini" bindtap="search" disabled="{{loading}}">查询</button></view><button wx:if="{{isConfig}}" bindtap="create">新建配置</button><button wx:if="{{canExport}}" bindtap="exportCsv" disabled="{{loading}}">导出 CSV（最多2000行）</button><button wx:if="{{hasExport}}" bindtap="shareCsv">发送 CSV 文件</button><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}">正在读取…</view><view wx:if="{{loaded && !rows.length && !loading}}">暂无记录</view><view wx:for="{{rows}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view wx:for="{{item.fields}}" wx:for-item="field" wx:key="label">{{field.label}}：{{field.value}}</view><view wx:if="{{detail}}">查看详情 ›</view><view wx:if="{{isConfig}}" class="actions"><button size="mini" catchtap="edit" data-id="{{item.id}}">编辑</button><button size="mini" catchtap="remove" disabled="{{busy || unknown}}" data-id="{{item.id}}" data-revision="{{item.revision}}">删除</button></view></view><button wx:if="{{rows.length < total}}" disabled="{{loading}}" bindtap="more">加载更多</button></view>
