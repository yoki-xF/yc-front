<view class="page"><view wx:if="{{loading}}">正在读取…</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!loading}}"><view wx:for="{{fields}}" wx:key="key" class="card"><view>{{item.label}}</view><input value="{{values[item.key]}}" data-key="{{item.key}}" bindinput="input" type="{{item.numeric ? 'number' : 'text'}}" password="{{item.key === 'handlerParam'}}" disabled="{{saving || (editing && item.key === 'handlerName')}}"/></view><button bindtap="save" disabled="{{saving || unknown}}">{{saving ? '保存中…' : '保存'}}</button></view></view>
