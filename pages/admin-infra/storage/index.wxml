<view class="page"><view class="heading">{{title}}</view><view wx:if="{{error}}" class="card error">{{error}}</view><view wx:if="{{notice}}" class="card">{{notice}}</view><view wx:if="{{loading}}" class="card">正在读取…</view>
 <block wx:if="{{!editing}}"><view class="card"><input value="{{keyword}}" bindinput="filter" placeholder="按名称或文件路径搜索" disabled="{{loading || busy}}"/><button bindtap="search" disabled="{{loading || busy}}">查询 / 刷新</button><button wx:if="{{cap.create}}" bindtap="{{key === 'file' ? 'upload' : 'create'}}" disabled="{{loading || busy || uncertain}}">{{key === 'file' ? '上传文件（最多20MB）' : '新增存储配置'}}</button><button wx:if="{{hasFile}}" bindtap="share">发送已下载文件</button><button wx:if="{{uncertain || saved}}" bindtap="back" disabled="{{busy}}">返回列表核对</button></view>
  <view wx:for="{{rows}}" wx:key="id" class="card"><view>{{item.name}} · {{item.id}}</view><view class="hint">{{key === 'file' ? item.size + ' 字节' : (item.master ? '当前主配置' : '备用配置')}} · {{item.createTime}}</view><button wx:if="{{key === 'file-config'}}" data-id="{{item.id}}" bindtap="edit" disabled="{{loading || busy || uncertain}}">查看与编辑</button><button wx:if="{{key === 'file'}}" data-id="{{item.id}}" data-action="download" bindtap="action" disabled="{{loading || busy}}">下载</button><button wx:if="{{key === 'file-config' &amp;&amp; cap.update &amp;&amp; !item.master}}" data-id="{{item.id}}" data-action="master" bindtap="action" disabled="{{loading || busy || uncertain || saved}}">设为主配置</button><button wx:if="{{key === 'file-config' &amp;&amp; cap.test}}" data-id="{{item.id}}" data-action="test" bindtap="action" disabled="{{loading || busy || uncertain || saved}}">上传测试文件</button><button wx:if="{{cap.delete}}" data-id="{{item.id}}" data-action="delete" bindtap="action" disabled="{{loading || busy || uncertain || saved}}">安全删除</button></view><view wx:if="{{!loading &amp;&amp; !rows.length}}" class="card">暂无记录</view><view class="pagination"><button bindtap="previous" disabled="{{loading || busy || pageNo &lt;= 1}}">上一页</button><text>第 {{pageNo}} 页 / {{total}} 条</text><button bindtap="next" disabled="{{loading || busy || pageNo * 20 &gt;= total}}">下一页</button></view>
 </block><block wx:else><view class="card"><view>配置名称</view><input value="{{values.name}}" data-key="name" bindinput="input" disabled="{{busy || uncertain || saved || !canWrite}}"/><picker range="{{types}}" range-key="name" value="{{typeIndex}}" bindchange="type" disabled="{{busy || uncertain || saved || isExisting}}"><view class="field">存储类型：{{types[typeIndex].name}} ›</view></picker><view>连接参数（JSON对象，密钥使用下方输入框）</view><textarea value="{{values.configText}}" data-key="configText" bindinput="input" maxlength="20000" disabled="{{busy || uncertain || saved || !canWrite}}"/><view class="field" wx:for="{{secretFields}}" wx:key="*this"><view>{{item}} · 修改时留空保留</view><input password="{{true}}" value="{{credentials[item]}}" data-key="{{item}}" bindinput="secret" disabled="{{busy || uncertain || saved || !canWrite}}"/></view><view>备注</view><input value="{{values.remark}}" data-key="remark" bindinput="input" maxlength="500" disabled="{{busy || uncertain || saved || !canWrite}}"/><button wx:if="{{canWrite}}" type="primary" bindtap="save" loading="{{busy}}" disabled="{{busy || uncertain || saved || !canWrite}}">保存配置</button></view><button bindtap="back" disabled="{{busy}}">返回列表核对</button></block>
</view>
