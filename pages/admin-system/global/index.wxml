<view class="page"><view wx:if="{{loading}}">正在读取…</view><view wx:if="{{error}}">{{error}}<button wx:if="{{!editing}}" bindtap="load">重试</button></view><view wx:if="{{notice}}">{{notice}}</view><block wx:if="{{!editing}}"><button wx:if="{{canExport && (type === 'dict-types' || type === 'dict-data')}}" bindtap="exportData" disabled="{{loading || exporting}}">导出（最多1000行）</button><input placeholder="搜索名称" value="{{searchText}}" bindinput="searchInput"/><button bindtap="search" disabled="{{loading}}">搜索</button><view wx:if="{{dictType}}">字典类型：{{dictType}}</view><button wx:if="{{canCreate}}" bindtap="create" disabled="{{loading}}">新增</button><view wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" style="margin-left: {{item.depth * 16}}px" bindtap="open">{{item.label}} · {{item.status === 0 ? '启用' : '停用'}} <text wx:if="{{item.parentId}}">（父级 {{item.parentId}}）</text> ›<button wx:if="{{item.parentId && canCreate}}" data-id="{{item.id}}" catchtap="child">新增子菜单</button><button wx:if="{{item.dictType}}" data-type="{{item.dictType}}" catchtap="drill">查看字典数据</button></view><view wx:if="{{!loading && !rows.length}}">暂无记录</view><view>第 {{pageNo}} 页 · 共 {{total}} 条</view><button wx:if="{{type !== 'menus'}}" bindtap="previous" disabled="{{loading || pageNo <= 1}}">上一页</button><button wx:if="{{type !== 'menus'}}" bindtap="next" disabled="{{loading || pageNo * 20 >= total}}">下一页</button></block><block wx:else><view wx:for="{{fields}}" wx:key="key"><view>{{item.label}}</view><input value="{{values[item.key]}}" data-key="{{item.key}}" bindinput="input" disabled="{{busy || uncertain || saved}}" maxlength="500" /></view><view>停用保留记录；更改菜单可能影响访问权限，请仔细核对。</view><button wx:if="{{canSubmit}}" bindtap="submit" disabled="{{busy || uncertain || saved}}" loading="{{busy}}">保存</button><button wx:if="{{canRemove}}" bindtap="remove" disabled="{{busy || saved || uncertain}}">{{type === 'dict-data' ? '停用字典项并保留历史' : '删除未使用记录'}}</button><button bindtap="back" disabled="{{busy}}">返回列表核对</button></block></view>
