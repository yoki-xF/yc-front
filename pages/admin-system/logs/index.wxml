<view class="page"><view wx:if="{{loading}}">正在读取…</view><view wx:if="{{error}}">{{error}}<button bindtap="load">重试</button></view><block wx:if="{{!detail}}"><input placeholder="账号编号（可选）" value="{{filter.userId}}" data-key="userId" bindinput="filterInput" disabled="{{loading}}"/><input placeholder="{{isLogin ? '登录结果状态码（可选）' : '操作类型或名称（可选）'}}" value="{{filter.keyword}}" data-key="keyword" bindinput="filterInput" disabled="{{loading}}"/><input placeholder="开始日期 YYYY-MM-DD" value="{{filter.startDate}}" data-key="startDate" bindinput="filterInput" disabled="{{loading}}"/><input placeholder="结束日期 YYYY-MM-DD" value="{{filter.endDate}}" data-key="endDate" bindinput="filterInput" disabled="{{loading}}"/><input wx:if="{{isLogin}}" placeholder="用户名" value="{{filter.username}}" data-key="username" bindinput="filterInput" disabled="{{loading}}"/><input placeholder="来源 IP" value="{{filter.userIp}}" data-key="userIp" bindinput="filterInput" disabled="{{loading}}"/><block wx:if="{{!isLogin}}"><input placeholder="操作模块" value="{{filter.type}}" data-key="type" bindinput="filterInput" disabled="{{loading}}"/><input placeholder="操作名称" value="{{filter.subType}}" data-key="subType" bindinput="filterInput" disabled="{{loading}}"/><input placeholder="操作内容" value="{{filter.action}}" data-key="action" bindinput="filterInput" disabled="{{loading}}"/><input placeholder="业务编号" value="{{filter.bizId}}" data-key="bizId" bindinput="filterInput" disabled="{{loading}}"/></block><button bindtap="search" disabled="{{loading}}">筛选</button><view>导出使用当前筛选条件，最多1000行。</view><button wx:if="{{canExport}}" bindtap="exportData" disabled="{{loading || exporting}}">导出（最多1000行）</button><view wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view>编号 {{item.id}} · 用户 {{item.user_id}}</view><view>{{item.create_time}} · {{item.type}} {{item.sub_type}} {{item.log_type}} {{item.result}} {{item.request_method}}</view></view><view wx:if="{{!loading && !rows.length}}">暂无记录</view><view>第 {{pageNo}} 页 · 共 {{total}} 条</view><button bindtap="previous" disabled="{{loading || pageNo <= 1}}">上一页</button><button bindtap="next" disabled="{{loading || pageNo * 20 >= total}}">下一页</button></block><block wx:else><view>编号：{{detail.id}}</view><view>用户：{{detail.user_id}} · 类型：{{detail.user_type}}</view><view>时间：{{detail.create_time}}</view><view wx:if="{{detail.username}}">账号：{{detail.username}}</view><view wx:if="{{detail.user_ip}}">来源 IP：{{detail.user_ip}}</view><view wx:if="{{detail.user_agent}}">客户端：{{detail.user_agent}}</view><view wx:if="{{detail.trace_id}}">追踪编号：{{detail.trace_id}}</view><view wx:if="{{detail.biz_id}}">业务编号：{{detail.biz_id}}</view><view wx:if="{{detail.request_url}}">请求路径：{{detail.request_url}}</view><view wx:if="{{detail.action}}">操作明细：{{detail.action}}</view><view wx:if="{{detail.extra}}">扩展参数：{{detail.extra}}</view><view>{{detail.type}} {{detail.sub_type}} {{detail.request_method}} {{detail.log_type}} {{detail.result}}</view><button bindtap="back">返回列表</button></block></view>
