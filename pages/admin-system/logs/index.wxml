<view class="page"><view wx:if="{{loading}}">正在读取…</view><view wx:if="{{error}}">{{error}}<button bindtap="load">重试</button></view><block wx:if="{{!detail}}"><input placeholder="账号编号（可选）" value="{{filter.userId}}" data-key="userId" bindinput="filterInput" disabled="{{loading}}"/><input placeholder="{{isLogin ? '登录结果状态码（可选）' : '操作类型或名称（可选）'}}" value="{{filter.keyword}}" data-key="keyword" bindinput="filterInput" disabled="{{loading}}"/><input placeholder="开始日期 YYYY-MM-DD" value="{{filter.startDate}}" data-key="startDate" bindinput="filterInput" disabled="{{loading}}"/><input placeholder="结束日期 YYYY-MM-DD" value="{{filter.endDate}}" data-key="endDate" bindinput="filterInput" disabled="{{loading}}"/><button bindtap="search" disabled="{{loading}}">筛选</button><view>导出使用当前筛选条件，最多1000行。</view><button wx:if="{{canExport}}" bindtap="exportData" disabled="{{loading || exporting}}">导出（最多1000行）</button><view wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view>编号 {{item.id}} · 用户 {{item.user_id}}</view><view>{{item.create_time}} · {{item.type}} {{item.sub_type}} {{item.log_type}} {{item.result}} {{item.request_method}}</view></view><view wx:if="{{!loading && !rows.length}}">暂无记录</view><view>第 {{pageNo}} 页 · 共 {{total}} 条</view><button bindtap="previous" disabled="{{loading || pageNo <= 1}}">上一页</button><button bindtap="next" disabled="{{loading || pageNo * 20 >= total}}">下一页</button></block><block wx:else><view>编号：{{detail.id}}</view><view>用户：{{detail.user_id}} · 类型：{{detail.user_type}}</view><view>时间：{{detail.create_time}}</view><view>{{detail.type}} {{detail.sub_type}} {{detail.request_method}} {{detail.log_type}} {{detail.result}}</view><button bindtap="back">返回列表</button></block></view>
