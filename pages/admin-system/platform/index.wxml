<view class="page"><view wx:if="{{loading}}">正在读取…</view><view wx:if="{{error}}">{{error}}<button wx:if="{{!editing}}" bindtap="load">重试</button></view><view wx:if="{{notice}}">{{notice}}</view><block wx:if="{{!editing}}"><button wx:if="{{canExport && kind === 'tenants'}}" bindtap="exportData" disabled="{{loading || exporting}}">导出（最多1000行）</button><input placeholder="搜索名称" value="{{searchText}}" bindinput="searchInput"/><button bindtap="search" disabled="{{loading}}">搜索</button><button wx:if="{{canCreate}}" bindtap="create" disabled="{{loading}}">新增</button><view wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="open">{{item.name}} · {{item.status === 0 ? '启用' : '停用'}} ›</view><view wx:if="{{!loading && !rows.length}}">暂无记录</view><view>第 {{pageNo}} 页 · 共 {{total}} 条</view><button bindtap="previous" disabled="{{loading || pageNo <= 1}}">上一页</button><button bindtap="next" disabled="{{loading || pageNo * 20 >= total}}">下一页</button></block><block wx:else><view wx:for="{{fields}}" wx:key="0"><view>{{item[1]}}</view><input value="{{values[item[0]]}}" data-key="{{item[0]}}" bindinput="input" password="{{item[0] === 'password'}}" disabled="{{busy || uncertain || saved}}" maxlength="500" /></view><checkbox-group wx:if="{{menus.length}}" bindchange="choose"><label wx:for="{{menus}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{item.disabled || busy || saved || uncertain}}" />{{item.name}}（{{item.id}}）</label></checkbox-group><view>停用保留历史。套餐菜单修改会影响关联租户权限。</view><button wx:if="{{canSubmit}}" bindtap="submit" disabled="{{busy || uncertain || saved}}" loading="{{busy}}">保存</button><button wx:if="{{canRetire}}" bindtap="retire" disabled="{{busy || saved || uncertain}}">{{kind === 'tenants' ? '停用租户并保留历史' : '删除未使用套餐'}}</button><button bindtap="back" disabled="{{busy}}">返回列表核对</button></block></view>
