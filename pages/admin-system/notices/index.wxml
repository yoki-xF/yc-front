<view class="page yc-page"><page-heading eyebrow="公告与消息" title="公告管理" description="编辑公告内容与状态，提交结果待确认时不要重复保存。" /><view wx:if="{{loading}}">正在读取公告…</view><view wx:if="{{error}}">{{error}}<button wx:if="{{!editing}}" bindtap="load">重试</button></view><view wx:if="{{notice}}">{{notice}}</view><block wx:if="{{!editing}}"><input placeholder="搜索名称" value="{{searchText}}" bindinput="searchInput"/><button bindtap="search" disabled="{{loading}}">搜索</button><button wx:if="{{canCreate}}" bindtap="create" disabled="{{loading}}">新增公告</button><view wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="open">{{item.title}} · {{item.status === 0 ? '启用' : '停用'}} ›</view><view wx:if="{{!loading && !rows.length}}">暂无公告</view><view>第 {{pageNo}} 页 · 共 {{total}} 条</view><button bindtap="previous" disabled="{{loading || pageNo <= 1}}">上一页</button><button bindtap="next" disabled="{{loading || pageNo * 20 >= total}}">下一页</button></block><block wx:else><view>标题<input value="{{values.title}}" data-key="title" bindinput="input" maxlength="50" disabled="{{busy || uncertain || saved}}" /></view><view>内容<textarea value="{{values.content}}" data-key="content" bindinput="input" maxlength="10000" disabled="{{busy || uncertain || saved}}" /></view><picker range="{{['通知','公告']}}" value="{{values.type - 1}}" bindchange="type" disabled="{{busy || uncertain || saved}}"><view>类型：{{values.type === '1' ? '通知' : '公告'}}</view></picker><picker range="{{['启用','停用']}}" value="{{values.status}}" bindchange="status" disabled="{{busy || uncertain || saved}}"><view>状态：{{values.status === '0' ? '启用' : '停用'}}</view></picker><view>停用保留公告记录。</view><button wx:if="{{canPush}}" bindtap="push" disabled="{{busy || pushUncertain || saved}}">推送已保存公告</button><button wx:if="{{canSubmit}}" bindtap="submit" disabled="{{busy || uncertain || saved}}" loading="{{busy}}">保存</button><button wx:if="{{canRemove}}" bindtap="remove" disabled="{{busy || saved || uncertain}}">删除公告</button><button bindtap="back" disabled="{{busy}}">返回列表核对</button></block></view>
