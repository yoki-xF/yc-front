<view class="page yc-page"><page-heading eyebrow="组织与权限" title="岗位管理" description="管理岗位资料与状态，保留关联和权限校验。" /><view wx:if="{{loading}}">正在读取岗位…</view><view wx:if="{{error}}">{{error}}<button wx:if="{{!editing}}" bindtap="load">重试</button></view><view wx:if="{{notice}}">{{notice}}</view><block wx:if="{{!editing}}"><button wx:if="{{canExport}}" bindtap="exportData" disabled="{{loading || exporting}}">导出（最多1000行）</button><input placeholder="搜索名称" value="{{searchText}}" bindinput="searchInput"/><button bindtap="search" disabled="{{loading}}">搜索</button><button wx:if="{{canCreate}}" bindtap="create" disabled="{{loading}}">新增岗位</button><view wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="open">{{item.name}} · {{item.code}} · {{item.status === 0 ? '启用' : '停用'}} ›</view><view wx:if="{{!loading && !rows.length}}">暂无岗位</view><view>第 {{pageNo}} 页 · 共 {{total}} 条</view><button bindtap="previous" disabled="{{loading || pageNo <= 1}}">上一页</button><button bindtap="next" disabled="{{loading || pageNo * 20 >= total}}">下一页</button></block><block wx:else><view>岗位名称<input value="{{values.name}}" data-key="name" bindinput="input" maxlength="50" disabled="{{busy || uncertain || saved}}" /></view><view>编码<input value="{{values.code}}" data-key="code" bindinput="input" maxlength="64" disabled="{{busy || uncertain || saved}}" /></view><view>排序<input value="{{values.sort}}" data-key="sort" bindinput="input" type="number" disabled="{{busy || uncertain || saved}}" /></view><picker range="{{['启用','停用']}}" value="{{values.status}}" bindchange="status" disabled="{{busy || uncertain || saved}}"><view>状态：{{values.status === '0' ? '启用' : '停用'}}</view></picker><view>备注<textarea value="{{values.remark}}" data-key="remark" bindinput="input" maxlength="500" disabled="{{busy || uncertain || saved}}" /></view><view>停用保留历史关联。</view><button wx:if="{{canSubmit}}" bindtap="submit" disabled="{{busy || uncertain || saved}}" loading="{{busy}}">保存</button><button wx:if="{{canRemove}}" bindtap="remove" disabled="{{busy || saved || uncertain}}">删除未分配岗位</button><button bindtap="back" disabled="{{busy}}">返回列表核对</button></block></view>
