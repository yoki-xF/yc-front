<view class="page"><view class="title">{{title}}</view><view class="notice">只读管理记录。变更请使用原有营业流程或统一更正。</view><view class="error">{{error}}</view><view wx:if="{{!detail}}"><input placeholder="门店编号（可选，仅授权门店）" data-field="deptId" value="{{deptId}}" bindinput="input"/><input placeholder="单号、票种或活动名称" data-field="keyword" value="{{keyword}}" bindinput="input"/><picker mode="date" data-field="start" value="{{start}}" bindchange="date"><view>创建日期起：{{start||'请选择'}}</view></picker><picker mode="date" data-field="end" value="{{end}}" bindchange="date"><view>创建日期止：{{end||'请选择'}}</view></picker><button bindtap="query" disabled="{{loading}}">查询</button><button wx:if="{{canExport}}" bindtap="exportCsv" disabled="{{loading}}">导出 CSV（最多 2000 行）</button><button wx:if="{{exportPath}}" bindtap="shareCsv">发送 CSV 文件</button><view>共 {{total}} 条</view><view class="card" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view>{{item.title}}</view><view wx:for="{{item.fields}}" wx:for-item="field" wx:key="key">{{field.label}}：{{field.value}}</view></view><button wx:if="{{rows.length<total}}" bindtap="more" disabled="{{loading}}">加载更多</button><view wx:if="{{!loading&&!rows.length}}">暂无记录</view></view><view wx:else><view class="card"><view wx:for="{{detail}}" wx:key="key">{{item.label}}：{{item.value}}</view></view><view class="card" wx:for="{{lines}}" wx:key="id"><view>明细</view><view wx:for="{{item.fields}}" wx:for-item="field" wx:key="key">{{field.label}}：{{field.value}}</view></view></view><view wx:if="{{loading}}">加载中…</view></view>