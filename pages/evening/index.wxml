<view class="page">
  <view class="store">当前门店：{{deptName}}</view>
  <view wx:if="{{loading}}" class="card">正在读取盘点数据…</view>
  <view wx:elif="{{error && !items.length}}" class="card error">{{error}}<button size="mini" bindtap="retry">重试</button></view>
  <block wx:else>
    <view class="card"><view class="line"><text>即开票库存盘点</text><text>{{total}}</text></view><view class="line"><text>剩余包数</text><text>{{packages}}</text></view><view class="line"><text>剩余张数</text><text>{{sheets}}</text></view></view>
    <view class="section"><text>即开票</text><button size="mini" bindtap="clearCounts" disabled="{{busy || conflict}}">清空数量</button></view>
    <view wx:if="{{!items.length}}" class="card">当前没有票据明细，可添加票种。</view>
    <view wx:for="{{items}}" wx:key="materialId" class="card">
      <view class="line"><text>{{item.materialName}}</text><text>面值 {{item.money}} / 包价 {{item.price}}</text></view>
      <view class="line"><text>库存包数</text><input type="number" value="{{item.invPackageNum}}" data-index="{{index}}" data-field="invPackageNum" bindinput="inputItem" disabled="{{busy || conflict}}" placeholder="请输入包数" /></view>
      <view class="line"><text>库存张数</text><input type="number" value="{{item.invZhangNum}}" data-index="{{index}}" data-field="invZhangNum" bindinput="inputItem" disabled="{{busy || conflict}}" placeholder="请输入张数" /></view>
    </view>
    <picker range="{{materials}}" range-key="materialName" bindchange="addMaterial" disabled="{{busy || conflict || !materials.length}}"><view class="add">{{materials.length ? '添加票种' : '暂无可添加票种'}}</view></picker>
    <view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
    <button wx:if="{{conflict}}" bindtap="reloadLatest" disabled="{{busy || loading}}">放弃草稿并加载最新数据</button>
    <button wx:if="{{uncertain}}" bindtap="confirmChecked">已核对当天记录和库存</button>
    <button type="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || uncertain || conflict}}">提交晚盘点</button>
  </block>
</view>
