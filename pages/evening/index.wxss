.page { padding: 32rpx; } .store { color: #526276; margin-bottom: 24rpx; } .card { margin-bottom: 24rpx; padding: 16rpx 28rpx; background: white; border-radius: 16rpx; } .line { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; min-height: 88rpx; border-bottom: 1rpx solid #edf0f4; } .line:last-child { border: 0; } input { flex: 1; text-align: right; } textarea { box-sizing: border-box; width: 100%; min-height: 120rpx; padding: 20rpx; background: #f5f7fa; margin: 20rpx 0; } .section { display: flex; justify-content: space-between; align-items: center; margin: 24rpx 0; font-weight: 600; } .section button { margin: 0; } .add { padding: 24rpx; text-align: center; color: #1677d2; background: white; border-radius: 16rpx; } .warning, .error { color: #b42318; margin: 20rpx 0; } .notice { color: #246642; margin: 20rpx 0; } button { margin-top: 24rpx; }
