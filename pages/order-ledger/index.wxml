<view class="page"><view class="store">当前门店：{{deptName}}</view>
  <view class="tabs"><view data-type="purchase" bindtap="switchType" class="tab {{type === 'purchase' ? 'selected' : ''}}">订票单据</view><view data-type="transfer" bindtap="switchType" class="tab {{type === 'transfer' ? 'selected' : ''}}">调拨单据</view></view>
  <view class="hint">订票支持建单、确认入库和作废；调拨由调入门店建单、调出门店确认。</view>
  <view wx:if="{{type === 'transfer'}}" class="tabs"><view data-direction="in" bindtap="switchDirection" class="tab {{direction === 'in' ? 'selected' : ''}}">调入</view><view data-direction="out" bindtap="switchDirection" class="tab {{direction === 'out' ? 'selected' : ''}}">调出</view></view>
  <button wx:if="{{type === 'purchase' || direction === 'in'}}" type="primary" bindtap="create">{{type === 'purchase' ? '新建订票单' : '新建调拨单'}}</button>
  <view wx:if="{{error}}" class="error">{{error}}<button size="mini" bindtap="refresh" disabled="{{loading}}">重试</button></view>
  <view wx:if="{{loading && !loaded}}" class="card">正在读取单据…</view><view wx:elif="{{loaded && !items.length}}" class="card">暂无单据</view>
  <view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="detail"><view class="heading"><text>{{item.orderNo}}</text><text class="status">{{item.status}}</text></view><view class="row"><text>总金额</text><text>{{item.amount}} 元</text></view><view wx:if="{{type === 'transfer' && direction === 'in' && item.exDeptName}}" class="row"><text>调出门店</text><text>{{item.exDeptName}}</text></view><view wx:if="{{type === 'transfer' && direction === 'out' && item.targetName}}" class="row"><text>调入门店</text><text>{{item.targetName}}</text></view><view class="row"><text>建单人</text><text>{{item.userName}}</text></view><view class="row"><text>创建时间</text><text>{{item.created}}</text></view><view wx:if="{{item.remark}}" class="hint">备注：{{item.remark}}</view><view class="link">查看详情 ›</view></view>
  <button wx:if="{{loaded && items.length < total}}" bindtap="more" loading="{{loading}}" disabled="{{loading}}">加载更多</button><button wx:if="{{loaded}}" bindtap="refresh" disabled="{{loading}}">刷新</button>
</view>
