.container { padding: 32rpx; } .notice, .card { padding: 24rpx; border-radius: 16rpx; background: #fff; } .notice button { margin: 18rpx 0 0; } .row { display: flex; justify-content: space-between; align-items: center; gap: 24rpx; min-height: 90rpx; border-bottom: 1rpx solid #edf0f4; } .row:last-child { border: 0; } .row text:last-child { color: #647184; text-align: right; word-break: break-all; } .avatar { width: 90rpx; height: 90rpx; border-radius: 50%; margin: 16rpx 0; }
