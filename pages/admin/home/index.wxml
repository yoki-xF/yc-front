<view class="workspace">
  <view class="ws-header"><view class="ws-eyebrow">易彩 · 管理中心</view><view class="ws-title">后台管理</view><view class="ws-subtitle">客户、权限与业务配置，按当前账号权限展示。</view></view>
  <view wx:if="{{loading}}" class="ws-card ws-note">正在读取权限…</view>
  <view wx:elif="{{error}}" class="ws-card"><view class="ws-error">{{error}}</view><button class="ws-primary" bindtap="retry">重试读取</button></view>
  <block wx:else>
    <view wx:if="{{!groups.length}}" class="ws-card ws-note">当前账号没有后台管理权限，请联系管理员。</view>
    <view wx:for="{{groups}}" wx:key="title"><view class="ws-section">{{item.title}}</view><view class="ws-card"><button class="ws-row" wx:for="{{item.entries}}" wx:for-item="entry" wx:key="key" data-key="{{entry.key}}" bindtap="open"><view class="ws-row-label"><text>{{entry.title}}</text><text>›</text></view></button></view></view>
    <view class="ws-note">门店营业操作与留痕更正请从对应工作台进入。</view>
  </block>
</view>
