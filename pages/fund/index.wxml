<view class="page yc-page">
  <page-heading eyebrow="营业任务" title="资金盘点" description="五类资金由门店共用，请逐项核对金额与笔数。" dept-name="{{deptName}}" />

  <view wx:if="{{loading}}" class="card">正在读取资金盘点…</view>
  <view wx:elif="{{error && !ready}}" class="card error">{{error}}<button size="mini" bindtap="retry">重试</button></view>
  <block wx:else>
    <view class="submit-note">金额必填，最多两位小数；笔数选填。提交前会再次核对，结果待确认时不要重复提交。</view>
    <view class="card"><view class="account-title"><text class="account-number">01</text><text>现金</text></view>
      <view class="line"><text>账户金额</text><input type="text" value="{{xj}}" data-field="xj" bindinput="input" disabled="{{busy}}" placeholder="请输入金额" /><text>元</text></view>
    </view>
    <view class="card"><view class="account-title"><text class="account-number">02</text><text>微信余额</text></view>
      <view class="line"><text>账户金额</text><input type="text" value="{{wxBalance}}" data-field="wxBalance" bindinput="input" disabled="{{busy}}" placeholder="请输入金额" /><text>元</text></view>
      <view class="line"><text>交易笔数</text><input type="number" value="{{wxBalanceCount}}" data-field="wxBalanceCount" bindinput="input" disabled="{{busy}}" placeholder="选填" /><text>笔</text></view>
    </view>
    <view class="card"><view class="account-title"><text class="account-number">03</text><text>收银通</text></view>
      <view class="line"><text>账户金额</text><input type="text" value="{{hsk}}" data-field="hsk" bindinput="input" disabled="{{busy}}" placeholder="请输入金额" /><text>元</text></view>
      <view class="line"><text>交易笔数</text><input type="number" value="{{hskCount}}" data-field="hskCount" bindinput="input" disabled="{{busy}}" placeholder="选填" /><text>笔</text></view>
    </view>
    <view class="card"><view class="account-title"><text class="account-number">04</text><text>支付宝</text></view>
      <view class="line"><text>账户金额</text><input type="text" value="{{zfb}}" data-field="zfb" bindinput="input" disabled="{{busy}}" placeholder="请输入金额" /><text>元</text></view>
      <view class="line"><text>交易笔数</text><input type="number" value="{{zfbCount}}" data-field="zfbCount" bindinput="input" disabled="{{busy}}" placeholder="选填" /><text>笔</text></view>
    </view>
    <view class="card"><view class="account-title"><text class="account-number">05</text><text>数字人民币</text></view>
      <view class="line"><text>账户金额</text><input type="text" value="{{szRmb}}" data-field="szRmb" bindinput="input" disabled="{{busy}}" placeholder="请输入金额" /><text>元</text></view>
      <view class="line"><text>交易笔数</text><input type="number" value="{{szRmbCount}}" data-field="szRmbCount" bindinput="input" disabled="{{busy}}" placeholder="选填" /><text>笔</text></view>
    </view>
    <view wx:if="{{notice || error || conflict || uncertain}}" class="feedback">
      <view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
      <button wx:if="{{conflict}}" bindtap="reloadLatest">放弃草稿并加载最新数据</button>
      <button wx:if="{{uncertain}}" bindtap="confirmChecked">已核对当天记录和余额</button>
    </view>
    <view class="submit-note">提交将更新当前门店共享资金余额，请核对五类资金后继续。</view>
    <button type="primary" bindtap="submit" loading="{{busy}}" disabled="{{loading || !ready || busy || uncertain || conflict}}">核对并提交资金盘点</button>
  </block>
</view>
