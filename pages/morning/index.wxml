<view class="page">
  <view class="store">当前门店：{{deptName}}</view>
  <view wx:if="{{loading}}" class="card">正在读取盘点数据…</view>
  <view wx:elif="{{error && !users.length}}" class="card error">{{error}}<button size="mini" bindtap="retry">重试</button></view>
  <block wx:else>
    <view class="card">
      <view class="line"><text>即开票库存盘点</text><text>{{total}}</text></view>
      <view class="line"><text>昨日库存差额</text><text>{{inventoryDiff}}</text></view>
      <view class="line"><text>昨日现金差额</text><text>{{cashDiff}}</text></view>
      <view wx:if="{{baseMissing}}" class="warning">未读取到期初现金，请先完善门店资金信息。</view>
    </view>
    <view class="card">
      <view class="line"><text>早现金盘点</text><input type="digit" value="{{cash}}" data-field="cash" bindinput="input" disabled="{{busy || fundsLocked}}" placeholder="请输入金额" /></view>
      <view class="line"><text>微信余额</text><input type="digit" value="{{wxBalance}}" data-field="wxBalance" bindinput="input" disabled="{{busy || fundsLocked}}" placeholder="请输入金额" /></view>
      <view class="line"><text>收银通余额</text><input type="digit" value="{{hsk}}" data-field="hsk" bindinput="input" disabled="{{busy || fundsLocked}}" placeholder="请输入金额" /></view>
      <view class="line"><text>支付宝余额</text><input type="digit" value="{{zfb}}" data-field="zfb" bindinput="input" disabled="{{busy || fundsLocked}}" placeholder="请输入金额" /></view>
      <view class="line"><text>数字人民币余额</text><input type="digit" value="{{szRmb}}" data-field="szRmb" bindinput="input" disabled="{{busy || fundsLocked}}" placeholder="请输入金额" /></view>
      <view wx:if="{{fundsLocked}}" class="warning">门店期初资金共用，当前只供核对。营业后的更正请由老板处理。</view>
      <view wx:if="{{countLocked}}" class="warning">门店已有营业或入账记录，已有早盘不能直接替换，请联系老板更正。</view>
      <picker range="{{users}}" range-key="label" value="{{userIndex}}" bindchange="changeUser" disabled="{{busy}}"><view class="line"><text>校对人员</text><text>{{userIndex >= 0 ? users[userIndex].label : '请选择'}}</text></view></picker>
      <textarea value="{{remark}}" data-field="remark" bindinput="input" disabled="{{busy}}" maxlength="255" placeholder="填写备注信息" />
    </view>
    <view class="section"><text>即开票</text><button size="mini" bindtap="clearCounts" disabled="{{busy}}">清空数量</button></view>
    <view wx:for="{{items}}" wx:key="materialId" class="card">
      <view class="line"><text>{{item.materialName}}</text><text>面值 {{item.money}} / 包价 {{item.price}}</text></view>
      <view class="line"><text>库存包数</text><input type="number" value="{{item.invPackageNum}}" data-index="{{index}}" data-field="invPackageNum" bindinput="inputItem" disabled="{{busy}}" placeholder="请输入包数" /></view>
      <view class="line"><text>库存张数</text><input type="number" value="{{item.invZhangNum}}" data-index="{{index}}" data-field="invZhangNum" bindinput="inputItem" disabled="{{busy}}" placeholder="请输入张数" /></view>
    </view>
    <picker range="{{materials}}" range-key="materialName" value="{{materialIndex}}" bindchange="addMaterial" disabled="{{busy || !materials.length}}"><view class="add">{{materials.length ? '添加票种' : '暂无可添加票种'}}</view></picker>
    <view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
    <button wx:if="{{conflict}}" bindtap="reloadLatest">放弃草稿并加载最新数据</button>
    <button wx:if="{{uncertain}}" bindtap="confirmChecked">已核对当天记录</button>
    <button type="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || uncertain || conflict || baseMissing || countLocked}}">提交早盘点</button>
  </block>
</view>
