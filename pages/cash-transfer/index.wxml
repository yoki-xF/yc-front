<view class="page">
  <view class="store">当前门店：{{deptName}}</view>
  <view class="card">
    <view class="heading">备付金转入</view><view class="hint">来源：备用金申请。提交后增加当前门店现金余额。</view>
    <view class="line"><text>转入金额</text><input type="text" value="{{amount}}" data-key="amount" bindinput="input" disabled="{{busy || uncertain}}" placeholder="请输入金额"/><text>元</text></view>
    <view class="hint">备注（选填，最多 300 字）</view><textarea value="{{remark}}" data-key="remark" bindinput="input" disabled="{{busy || uncertain}}" maxlength="300" placeholder="请输入备注"/>
    <view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
    <button wx:if="{{uncertain}}" bindtap="retryPending" disabled="{{busy || loading}}">使用原请求重试</button>
    <button type="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || loading || !loaded || uncertain}}">提交转入</button>
  </view>
  <view class="card"><view class="header"><text class="heading">转入流水</text><button size="mini" bindtap="retry" disabled="{{loading || busy}}">刷新</button></view>
    <view wx:if="{{loading}}" class="hint">正在读取流水…</view><view wx:elif="{{!loaded}}" class="error">读取流水失败，请重试。</view><view wx:elif="{{!records.length}}" class="hint">暂无流水</view>
    <view wx:for="{{records}}" wx:key="id" class="record"><view class="header"><text>{{item.source}}</text><text>{{item.amount}} 元</text></view><view class="hint">{{item.time}} · {{item.userName}}</view><view wx:if="{{item.remark}}" class="hint">备注：{{item.remark}}</view></view>
  </view>
</view>
